# /etc/tl-t3-sync/<user>.env — per-user config for tl-t3-sync@<user>.service.
#
# Copy this to /etc/tl-t3-sync/<user>.env, fill in the two per-user numbers
# (T3_PORT, TL_T3_SYNC_NOTIFY_PORT) and the home path, and install it 0644
# root:root. It carries no secret: the syncer's T3 bearer is minted in memory
# from `t3 auth session issue` and never written to disk. 0644 matters —
# tmux-api runs as wizard and reads TL_T3_SYNC_NOTIFY_PORT out of every user's
# file to deliver the kill-notify (t3-bridge/CONTRACT.md §8).
#
# Every key below is required. systemd expands an unset variable to an empty
# argument, so a missing key reaches the binary as `-interval ""` and fails the
# unit at start rather than falling back to a default nobody chose.

# The user's own t3-serve port, the same value as /etc/t3-serve/<user>.env.
# The syncer talks to 127.0.0.1 on this port and nothing else.
T3_PORT=3773

# The user's T3 state directory — what `t3 serve --base-dir` was given, and what
# the bearer is minted against. Always that user's own; never another's.
T3_BASE_DIR=/home/wizard/.t3

# Snapshot poll interval (Go duration). Fast enough that deleting a thread in T3
# feels immediate, slow enough to be invisible on the box.
TL_T3_SYNC_INTERVAL=5s

# Comma-separated tmux-session-name prefixes never mirrored into T3: the
# machine-made sessions (QA harness runs, bridge e2e sessions, agent worktrees)
# that have no reader (design decision 4). Empty = the built-in default list;
# the literal `none` = mirror everything.
TL_T3_SYNC_IGNORE=qa-,t3e2e-,tlp-t

# Loopback port for the syncer's kill-notify listener. Must be unique per user
# and free on this box — check with `ss -ltn` before picking. 7695-7699 is the
# block reserved for these (7684-7687 and 7690-7691 are already taken).
TL_T3_SYNC_NOTIFY_PORT=7695

# Optional extra flags, word-split. Empty for steady state. Set it to -dry-run
# for a user's first enablement so the first pass logs what it would do to a T3
# that already has threads, and clear it once the plan reads right.
TL_T3_SYNC_ARGS=
