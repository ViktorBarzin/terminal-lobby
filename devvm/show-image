#!/bin/sh
# Show an image to the human at the terminal. Inside tmux, renders in a
# temporary split pane via viu (sixel; Enter closes) — Claude Code's Bash
# tool captures stdout, so running bare `viu` from a tool call prints
# garbage instead; this helper targets the real pane tty via tmux.
# Outside tmux, plain viu.
# Usage: show-image <image-file>

if [ "$#" -ne 1 ]; then
    echo "Usage: show-image <image-file>" >&2
    exit 2
fi
if [ ! -f "$1" ] || [ ! -r "$1" ]; then
    echo "show-image: cannot read file: $1" >&2
    exit 1
fi

# Absolute path: the split pane and the gallery registration below both
# run without this shell's cwd. realpath is present on the devvm; the
# case fallback keeps the script POSIX-portable.
if command -v realpath >/dev/null 2>&1; then
    img=$(realpath "$1")
else
    case "$1" in
        /*) img=$1 ;;
        *)  img="$(pwd)/$1" ;;
    esac
fi

if [ -n "$TMUX" ]; then
    # -e passes the path out-of-band as an env var, so it survives spaces
    # and quotes: tmux putenvs the value verbatim and the pane's /bin/sh
    # only ever expands "$IMG" inside double quotes. The pane shell is
    # dash, whose `read` has no -n/-s — hence plain `read x` + Enter.
    # A split pane, not display-popup: tmux 3.4 popups don't pass sixel
    # through (empty box).
    tmux split-window -l 15 -e "IMG=$img" 'viu -h 12 "$IMG"; printf "\n[Enter closes]"; read x' || exit 1
    # Persist what was shown into the per-session gallery store
    # (docs/adr/0005-session-image-store.md) — unless it already lives
    # there. Fire-and-forget: the backgrounded subshell with all output
    # dropped means a dead or slow clipboard-upload service can never
    # break or delay rendering.
    case "$img" in
        /var/lib/clipboard-store/*) ;;
        *) (curl -s -m 5 -X POST http://127.0.0.1:7683/register \
                -F "user=$(id -un)" \
                -F "session=$(tmux display -p '#S')" \
                -F "path=$img" >/dev/null 2>&1 &) ;;
    esac
else
    exec viu "$img"
fi
