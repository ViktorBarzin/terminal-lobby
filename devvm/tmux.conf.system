# /etc/tmux.conf — system-wide tmux defaults for the terminal-lobby devvm.
# Installed by scripts/deploy.sh from devvm/tmux.conf.system.
#
# Provenance (Task 1.14 truecolor audit, 2026-07-11): ttyd attaches tmux
# clients with TERM=xterm-256color, which terminfo does not mark RGB-capable,
# so tmux down-converted 24-bit SGR to the 256-colour cube (a 77-colour test
# ramp rendered as ~12 hard bands in the lobby) and no user's ~/.tmux.conf
# enabled RGB either. The lobby's xterm.js client renders 24-bit colour
# natively — tell tmux so. Matches any xterm-compatible attach, including
# the read-only ttyd-ro view and SSH clients with an xterm* TERM.
#
# This file loads BEFORE per-user ~/.tmux.conf and -a APPENDS to the option,
# so users can still override or extend it. Already-running tmux servers
# pick it up at their next server start (tmux reads config when the server
# spawns, not per client).
set -as terminal-features 'xterm*:RGB'

# Provenance ([links] wrapped-URL fix, 2026-07-12): tmux 3.4 STRIPS OSC 8
# hyperlinks from output unless the attaching client's termfeatures include
# 'hyperlinks' (TERM=xterm-256color terminfo doesn't advertise it). The
# lobby's xterm.js handles OSC 8 natively (linkHandler in
# frontend/index.html) and the escape carries the FULL URI — immune to
# visual wrapping — so let it through for xterm-compatible attaches
# (rg --hyperlink, eza, gh & friends; Claude Code does not emit OSC 8).
# Same semantics as the RGB line: applies at each tmux server's next start.
set -as terminal-features 'xterm*:hyperlinks'
