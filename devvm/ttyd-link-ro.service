[Unit]
Description=ttyd for read-only public links (port 7692, /s, takes no input)
After=network.target

[Service]
# Public links (ADR-0039). This instance and ttyd-link-rw take connections from
# anyone: there is no -H, because a visitor has no identity to send. What
# authorizes an attach is the ticket in ?arg=, which tmux-link-attach.sh spends
# at tmux-api. The ingress routes /s/ here with no forward-auth.
#
# NO -W, and that is the point of a separate instance: ttyd drops every input
# frame from a client of a non-writable server, so not one keystroke reaches
# tmux. tmux's own -r is not enough on its own, because a read-only tmux client
# still runs keys bound to switch-client, and the default prefix ( and ) would
# take a watcher to the owner's other sessions.
#
# -O refuses a WebSocket whose Origin is another site, -m caps how many
# connections one instance holds, and the limits below cap what a flood of them
# can cost the box.
EnvironmentFile=-/etc/terminal-lobby.conf
EnvironmentFile=-/etc/terminal-lobby.local.conf
Environment=TL_BIND=127.0.0.1
ExecStart=/usr/local/bin/ttyd -i ${TL_BIND} -a -O -m 64 -P 30 -b /s -I /usr/local/share/ttyd/link.html -p 7692 /usr/local/bin/tmux-link-attach.sh ro
# tl-link, not wizard: the one terminal server reachable without signing in
# runs as an account whose only sudo grant is tmux-link-join (sudoers.d-tl-link).
User=tl-link
Restart=always
TasksMax=512
MemoryMax=512M

[Install]
WantedBy=multi-user.target
