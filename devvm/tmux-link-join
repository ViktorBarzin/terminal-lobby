#!/usr/bin/env bash
# The second half of a public-link attach (devvm/tmux-link-attach.sh is the
# first), running AS THE SESSION'S OWNER through tl-link's one sudo grant.
#
#   $1  the grant tmux-api handed the first half
#
# It spends the grant at tmux-api, which checks that the grant was issued to
# this account and this tty, and answers with tmux's session id and the mode.
# That id is attached and nothing else: the argv is fixed, the target matches
# ^\$[0-9]+$, and -r is dropped only when tmux-api said "rw". A session id is
# exact, so none of the prefix matching a bare name gets applies here.
#
# A grant that does not spend means no attach. There is no fallback, and no
# path in this file creates a session.
set -euo pipefail

TOKEN_RE='^[A-Za-z0-9_-]{32}$'
TTY_RE='^/dev/[a-zA-Z0-9/]{1,60}$'
TARGET_RE='^\$[0-9]+$'
API="${TL_TMUX_API:-http://127.0.0.1:7684}"

grant="${1:-}"
[[ "$grant" =~ $TOKEN_RE ]] || exit 1
me="$(id -un)"
my_tty="$(tty 2>/dev/null || true)"
[[ "$my_tty" =~ $TTY_RE ]] || exit 1

resp="$(curl -s -m 5 -w $'\n%{http_code}' -H 'Content-Type: application/json' \
    --data "{\"grant\":\"${grant}\",\"user\":\"${me}\",\"tty\":\"${my_tty}\"}" \
    "$API/internal/link-join" 2>/dev/null || true)"
code="$(printf '%s' "$resp" | tail -n1)"
target="$(printf '%s' "$resp" | sed -n 's/.*"target"[[:space:]]*:[[:space:]]*"\(\$[0-9]*\)".*/\1/p')"
mode="$(printf '%s' "$resp" | sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')"

if [[ "$code" != 200 || ! "$target" =~ $TARGET_RE ]]; then
    logger -t ttyd-link "DENIED: join as $me tty=$my_tty code=${code:-none}"
    printf '\r\n  This link has ended.\r\n'
    exit 1
fi

# Fail safe: read-only unless tmux-api explicitly said rw.
ro_flag=(-r)
[[ "$mode" == rw ]] && ro_flag=()
logger -t ttyd-link "join: $me $target mode=${mode:-ro} tty=$my_tty"
exec /usr/bin/tmux attach-session "${ro_flag[@]}" -t "$target"
