#!/usr/bin/env bash
# Installed at /usr/local/bin/tmux-persist-forget (root:root, mode 0755).
#
# Record that ONE session was killed DELIBERATELY — the "forget" half of a
# deliberate kill (tmux-api killSession, i.e. DELETE /sessions/<name> from the
# web UI).
#
# Why this has to exist: a restore recreates the sessions in a snapshot that
# are not currently live. Without this, a session the user just chose to kill
# comes straight back, and a row carrying a claude uuid comes back as
# `claude --resume <uuid>`, restarting a conversation they deliberately ended.
#
# HOW IT WORKS NOW (2026-08-14): tmux-persist keeps an immutable SERIES of
# snapshots rather than one rewritable manifest, so this can no longer delete a
# row — rewriting history would also erase the session from every older
# snapshot, and reaching an older version is the whole point of the picker.
# Instead `tmux-persist forget` appends a TOMBSTONE (name + kill time):
#   * a blanket restore skips names tombstoned after the snapshot it restores;
#   * the picker still OFFERS the row, just unticked and labelled with when it
#     was killed, so an accidental kill is one click from coming back.
# A kill BEFORE a snapshot does not suppress it — the session being captured
# again is evidence it was deliberately restarted.
#
# Sessions that die OUT of band (OOM, a crashed tmux server) never go through
# tmux-api's kill path, so they are never tombstoned and the crash recovery
# this whole feature exists for is untouched.
#
# Invoked ONLY by the tmux-api service (running as wizard) through the
# passwordless grant in /etc/sudoers.d/ttyd-users:
#     wizard ALL=(root) NOPASSWD: /usr/local/bin/tmux-persist-forget
#
# Why root: the tombstone file is root-owned 0600.
#
# Trust model — the same shape as tmux-restore-user and tmux-user-setfacl:
# ordinary input validation, so this root tool cannot become an arbitrary-file
# writer. It takes exactly two arguments; the user is re-validated against
# /etc/ttyd-user-map (so it can only ever touch a real terminal user's OWN
# state); and the session name must match tmux-api's own session-name charset
# (sessionNameRe: alnum, '_' and '-', <=32), which admits no '/', no '..' and
# no shell metacharacter. Both are passed to tmux-persist as separate argv
# entries, never interpolated into a shell string.
#
# Usage: tmux-persist-forget <user> <session>
# Exit: 0 also when there is nothing to record — the caller kills best-effort
# and must not see a spurious failure.
set -euo pipefail

MAP=/etc/ttyd-user-map
TMUX_PERSIST=/usr/local/bin/tmux-persist

u="${1:-}"
sess="${2:-}"
[[ $# -eq 2 ]] || { echo "usage: tmux-persist-forget <user> <session>" >&2; exit 2; }
[[ "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "tmux-persist-forget: invalid user '$u'" >&2; exit 2; }
# Mirrors tmux-api's sessionNameRe — anything outside it cannot name a session.
[[ "$sess" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] || { echo "tmux-persist-forget: invalid session '$sess'" >&2; exit 2; }

# os_user = right-hand side of the map, minus any optional :cwd suffix, and
# never a comment line (mirrors tmux-api's loadUserMap parsing, tmux-persist's
# own users(), and tmux-restore-user's check).
if ! sed -e 's/#.*//' "$MAP" | cut -d= -f2- | sed -e 's/:.*//' -e 's/[[:space:]]//g' \
     | grep -qxF "$u"; then
  echo "tmux-persist-forget: '$u' is not a terminal user (not in $MAP)" >&2
  exit 2
fi

exec "$TMUX_PERSIST" forget "$u" "$sess"
