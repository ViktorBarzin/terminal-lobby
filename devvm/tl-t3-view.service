# tl-t3-view — serves T3 Code's web client against lobby sessions (ADR-0044).
#
# A Node sidecar that speaks T3's orchestration protocol v2 to the pinned T3
# web build and translates to tmux-api and session-events. The lobby frames it
# from t3view.<domain> as the T3 view, admin only. Nobody's session runs
# through it, so its release checks are advisory (release/manifest.go).
#
# Design: docs/plans/2026-10-12-t3-view-design.md, t3-view/README.md.
[Unit]
Description=tl-t3-view (terminal-lobby T3 view sidecar)
Documentation=https://github.com/ViktorBarzin/terminal-lobby
After=network.target tmux-api.service session-events.service
# Keep retrying rather than give up: a sidecar in the start-limit state stays
# down until someone notices.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/terminal-lobby.conf
EnvironmentFile=-/etc/terminal-lobby.local.conf
# Every interface, for the ingress: Traefik reaches the box on 10.0.10.10.
# The sidecar ignores TL_BIND on purpose (t3-view/src/config.ts); the devvm
# firewall admits 7690 from the Traefik nodes only, and the sidecar checks the
# proxy secret itself on every request. Set TL_T3_VIEW_BIND in the local
# config to narrow it: an EnvironmentFile wins over Environment=.
Environment=TL_T3_VIEW_BIND=0.0.0.0
# The sidecar checks the proxy secret by asking tmux-api /whoami and refuses to
# start holding it. The local config carries it for the Go services, so it is
# dropped here, after both files are read.
UnsetEnvironment=TL_PROXY_SECRET
ExecStart=/usr/bin/node /usr/lib/terminal-lobby/tl-t3-view/tl-t3-view.mjs
User=wizard
Restart=always
RestartSec=2
SyslogIdentifier=tl-t3-view

# Writable state, should the sidecar keep any (systemd exports the path as
# STATE_DIRECTORY). Everything else is read-only.
StateDirectory=tl-t3-view
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# It starts near 110 MB resident and caches per user and session. If it ever
# grows past this, systemd stops it and Restart=always brings it back, which
# beats a sidecar that becomes the box's memory problem.
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
