# Install at /etc/sudoers.d/ttyd-users (mode 0440, owner root:root).
#
# wizard (the user running ttyd.service + tmux-api.service) needs to run
# tmux as the OS user that backs each Authentik identity. Keep the grant
# scoped to each named target user — never `(ALL)` — and to a fixed set of
# audited binaries:
#   /usr/bin/tmux               tmux-api polls `tmux list-sessions`
#   /usr/local/bin/tmux-user-attach   ttyd attach (re-homes the server into
#                                      the user's systemd scope; see script)
#   /usr/local/bin/tmux-user-dirlist  tmux-api GET /dirs (project dir picker).
#                                      Argument-free; prints dir NAMES under the
#                                      user's home. No input → nothing to inject.
#   /usr/local/bin/tmux-restore-user  tmux-api POST /restore (web-UI button).
#                                      Runs as root because it drives
#                                      tmux-persist's single-user restore (reads
#                                      the root-owned manifest + runuser into the
#                                      target user). Self-validates its one arg
#                                      against /etc/ttyd-user-map.
#   /usr/local/bin/tmux-persist-forget tmux-api DELETE /sessions/<name>: drops
#                                      the killed session from the root-owned
#                                      0600 restore manifest, so Restore cannot
#                                      resurrect it. Self-validates both args
#                                      (user against /etc/ttyd-user-map, session
#                                      against tmux-api's session-name charset).
#   /usr/local/bin/file-api           file-api re-execs ITSELF as the mapped
#                                      user (`-privop list|read|write`) so the
#                                      four-layer path validation in paths.go
#                                      runs with THAT user's view of the
#                                      filesystem — symlink resolution needs
#                                      their read access — confined to their own
#                                      home. Writes then land with their
#                                      ownership rather than the service's. The
#                                      child re-validates containment itself, so
#                                      the grant is scoped to one fixed
#                                      behaviour and takes no path it trusts.
#   /usr/local/bin/skills-api         skills-api re-execs ITSELF as the mapped
#                                      user (`-privop <op>`, request on stdin) so
#                                      each half of a skill install runs as the
#                                      user it belongs to: peer homes are 0700,
#                                      so the owner cannot write into the
#                                      recipient's home and the recipient cannot
#                                      read the owner's. The child takes ONE op
#                                      name in argv and nothing else — no home,
#                                      no path, no third-party user — resolves
#                                      its own home from its uid rather than
#                                      $HOME (sudo leaves the caller's HOME in
#                                      place), and re-validates every skill name
#                                      it is given. So this grant, like the two
#                                      below, takes no path it trusts. It also
#                                      covers `claude plugin update` for that
#                                      user, run from the child: the child is
#                                      already that user, so exec'ing their own
#                                      CLI grants nothing they could not do in a
#                                      terminal.
#   /usr/local/bin/session-events     session-events re-execs ITSELF as the
#                                      mapped user (`-privop`) to read that
#                                      user's Claude transcripts, which sit
#                                      inside a 0750 home the service cannot
#                                      open. It is a LONG-LIVED child, not a
#                                      per-operation re-exec like file-api's:
#                                      the transcript tail polls every 200 ms,
#                                      so one process per read would be one
#                                      fork per 200 ms per open session. It
#                                      speaks a fixed request/response protocol
#                                      on stdin/stdout, takes no arguments, and
#                                      re-validates every path against its OWN
#                                      projects root — so the grant, like
#                                      file-api's, trusts no path from the
#                                      caller.
#
# NOTE on what these lines are worth today: the service user (wizard) is an
# administrator with (ALL) NOPASSWD: ALL, so every grant below is already implied
# for them. They are kept exact and per-binary anyway — they document which
# binaries are meant to run as whom, and they are what would carry the behaviour
# if the services ever ran as a non-admin account.
#
# Add one line per OS user listed on the right-hand side of
# /etc/ttyd-user-map — which is itself GENERATED, hourly, from
# infra/scripts/workstation/roster.yaml (the one place a user is declared; this
# repo carried a second copy of the map until 2026-08-17 and no longer does).
# The roster says who exists and which Authentik username reaches them; this
# file is the kernel-level grant that makes the per-user attach actually work,
# and it stays hand-maintained on purpose — adding a roster user does NOT
# grant anything here, so a new user's attaches fail until this file gains
# their line and is deployed.

# One line per non-wizard OS user in /etc/ttyd-user-map. tmux-user-dirlist
# (GET /dirs) is granted alongside the attach binaries so the directory picker
# works for every user, not just wizard (whose own tmux-api runs its home scan
# directly, no sudo).
#
# These same grants carry the admin ACT-AS switch (?as=<user>, see the README):
# an administrator working as another user reaches tmux, tmux-user-attach and
# file-api through exactly these lines. No new grant was needed for it — who may
# use the switch is decided in the services against /etc/ttyd-admins, and
# tmux-attach.sh sources the decision from tmux-api's /internal/attach rather
# than from any client argument. Removing a user from /etc/ttyd-user-map is
# still what revokes everything here.
wizard ALL=(bob) NOPASSWD: /usr/bin/tmux, /usr/local/bin/tmux-user-attach, /usr/local/bin/tmux-user-dirlist, /usr/local/bin/file-api, /usr/local/bin/session-events, /usr/local/bin/skills-api
wizard ALL=(carol) NOPASSWD: /usr/bin/tmux, /usr/local/bin/tmux-user-attach, /usr/local/bin/tmux-user-dirlist, /usr/local/bin/file-api, /usr/local/bin/session-events, /usr/local/bin/skills-api

# Restore button (POST /restore): run the validated root wrapper. It accepts a
# single OS-user arg and re-checks it against /etc/ttyd-user-map, so this grant
# can only ever restore a real terminal user's OWN saved sessions. Target is
# root (not a per-user target) because tmux-persist itself does the per-user
# runuser + reads the root-owned manifest.
#
# tmux-user-setfacl (project co-ownership): applies/removes POSIX ACLs on a
# shared project dir for its members. Root because the tree holds files owned by
# several members (only root can setfacl all of them + fully revoke). The
# wrapper self-validates its args (canonical dir strictly under a home, real
# users, inode cap) so this grant can't become an arbitrary-path ACL writer.
#
# tmux-persist-forget (the other half of a deliberate kill): removes one row
# from /var/lib/tmux-persist/<user>.tsv, which is root-owned 0600. Same trust
# shape as the two above — exactly two args, user re-checked against
# /etc/ttyd-user-map, session name confined to tmux-api's sessionNameRe charset,
# and no path ever taken from the input, so it can't become an arbitrary-file
# line-deleter. It never touches <user>.history.tsv, so an accidental kill stays
# recoverable via `tmux-persist restore-one`.
wizard ALL=(root) NOPASSWD: /usr/local/bin/tmux-restore-user, /usr/local/bin/tmux-user-setfacl, /usr/local/bin/tmux-persist-forget
