# Install at /etc/sudoers.d/ttyd-users (mode 0440, owner root:root).
#
# wizard (the user running ttyd.service + tmux-api.service) needs to run
# tmux as the OS user that backs each Authentik identity. Keep the grant
# scoped to each named target user — never `(ALL)` — and to a fixed set of
# audited binaries:
#   /usr/bin/tmux               tmux-api polls `tmux list-sessions`
#   /usr/local/bin/tmux-user-attach   ttyd attach (re-homes the server into
#                                      the user's systemd scope; see script)
#   /usr/local/bin/tmux-user-dirlist  tmux-api GET /dirs (project dir picker).
#                                      Argument-free; prints dir NAMES under the
#                                      user's home. No input → nothing to inject.
#   /usr/local/bin/tmux-restore-user  tmux-api POST /restore (web-UI button).
#                                      Runs as root because it drives
#                                      tmux-persist's single-user restore (reads
#                                      the root-owned manifest + runuser into the
#                                      target user). Self-validates its one arg
#                                      against /etc/ttyd-user-map.
#   /usr/local/bin/tmux-persist-forget tmux-api DELETE /sessions/<name>: drops
#                                      the killed session from the root-owned
#                                      0600 restore manifest, so Restore cannot
#                                      resurrect it. Self-validates both args
#                                      (user against /etc/ttyd-user-map, session
#                                      against tmux-api's session-name charset).
#
# Add one line per OS user listed on the right-hand side of
# /etc/ttyd-user-map. The mapping file is the source of truth for which
# Authentik usernames are accepted; this file is the kernel-level grant
# that makes the per-user attach actually work.

# One line per non-wizard OS user in /etc/ttyd-user-map. tmux-user-dirlist
# (GET /dirs) is granted alongside the attach binaries so the directory picker
# works for every user, not just wizard (whose own tmux-api runs its home scan
# directly, no sudo).
wizard ALL=(emo) NOPASSWD: /usr/bin/tmux, /usr/local/bin/tmux-user-attach, /usr/local/bin/tmux-user-dirlist
wizard ALL=(ancamilea) NOPASSWD: /usr/bin/tmux, /usr/local/bin/tmux-user-attach, /usr/local/bin/tmux-user-dirlist

# Restore button (POST /restore): run the validated root wrapper. It accepts a
# single OS-user arg and re-checks it against /etc/ttyd-user-map, so this grant
# can only ever restore a real terminal user's OWN saved sessions. Target is
# root (not a per-user target) because tmux-persist itself does the per-user
# runuser + reads the root-owned manifest.
#
# tmux-user-setfacl (project co-ownership): applies/removes POSIX ACLs on a
# shared project dir for its members. Root because the tree holds files owned by
# several members (only root can setfacl all of them + fully revoke). The
# wrapper self-validates its args (canonical dir strictly under a home, real
# users, inode cap) so this grant can't become an arbitrary-path ACL writer.
#
# tmux-persist-forget (the other half of a deliberate kill): removes one row
# from /var/lib/tmux-persist/<user>.tsv, which is root-owned 0600. Same trust
# shape as the two above — exactly two args, user re-checked against
# /etc/ttyd-user-map, session name confined to tmux-api's sessionNameRe charset,
# and no path ever taken from the input, so it can't become an arbitrary-file
# line-deleter. It never touches <user>.history.tsv, so an accidental kill stays
# recoverable via `tmux-persist restore-one`.
wizard ALL=(root) NOPASSWD: /usr/local/bin/tmux-restore-user, /usr/local/bin/tmux-user-setfacl, /usr/local/bin/tmux-persist-forget
