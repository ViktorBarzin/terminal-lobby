[Unit]
Description=ttyd for read-write public links (port 7693, /s/rw)
After=network.target

[Service]
# The read-write twin of ttyd-link-ro (see there for why there are two). -W so
# a visitor holding a read-write link can type. tmux-api refuses a read-only
# link's ticket on this instance, so the input this server accepts only ever
# reaches a session whose owner chose read-write.
EnvironmentFile=-/etc/terminal-lobby.conf
EnvironmentFile=-/etc/terminal-lobby.local.conf
Environment=TL_BIND=127.0.0.1
ExecStart=/usr/local/bin/ttyd -i ${TL_BIND} -W -a -O -m 64 -P 30 -b /s/rw -I /usr/local/share/ttyd/link.html -p 7693 /usr/local/bin/tmux-link-attach.sh rw
User=tl-link
Restart=always
TasksMax=512
MemoryMax=512M

[Install]
WantedBy=multi-user.target
