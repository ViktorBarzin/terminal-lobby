Local ttyd 1.7.7 patch for terminal-lobby (applied by scripts/build-ttyd.sh
on top of upstream tag 1.7.7; leading text is ignored by `git apply`).

Two independent fixes, one binary:

1. Pixel size → pty (sixel; docs/adr/0004-sixel-images-in-the-terminal.md):
   stock ttyd hardcodes ws_xpixel/ws_ypixel to 0 on every resize, and tmux
   only re-emits sixel to clients whose pty reports a pixel size. Adds
   optional "xpixel"/"ypixel" fields to the RESIZE_TERMINAL message and
   forwards them via TIOCSWINSZ. Taken verbatim from the validated prototype
   tree; upstream PR planned.

2. Honor client PAUSE / RESUME (flow control; plan Task 3.4, upstream
   no-op — see tsl0922/ttyd PR #1560 for the adjacent upstream discussion):
   pty_spawn() leaves process->paused stuck true and nothing ever wrote the
   flag afterwards, so pty_pause()'s `if (process->paused) return;` always
   fired (PAUSE did nothing) — and even without that, the SERVER_WRITEABLE
   pump unconditionally pty_resume()d after flushing every chunk. Now:
   pty_pause() records paused=true + uv_read_stop; pty_resume() clears the
   flag + uv_read_start (unconditional — the read pump depends on resume
   always restarting after read_cb's per-chunk uv_read_stop; UV_EALREADY on
   an already-reading stream is harmless and unchecked); the pump only
   auto-resumes while NOT client-paused. The initial post-handshake resume
   and the client RESUME opcode stay unconditional, so a paused connection
   can always be revived — no deadlock (challenge-verified line-exact by two
   independent reviewers, 2026-07-11).

diff --git a/src/protocol.c b/src/protocol.c
index 53e65d4..bc8e912 100644
--- a/src/protocol.c
+++ b/src/protocol.c
@@ -276,7 +276,7 @@ int callback_tty(struct lws *wsi, enum lws_callback_reasons reason, void *user,
         wsi_output(wsi, pss->pty_buf);
         pty_buf_free(pss->pty_buf);
         pss->pty_buf = NULL;
-        pty_resume(pss->process);
+        if (!pss->process->paused) pty_resume(pss->process);
       }
       break;
 
@@ -315,8 +315,13 @@ int callback_tty(struct lws *wsi, enum lws_callback_reasons reason, void *user,
           break;
         case RESIZE_TERMINAL:
           if (pss->process == NULL) break;
-          json_object_put(
-              parse_window_size(pss->buffer + 1, pss->len - 1, &pss->process->columns, &pss->process->rows));
+          {
+            json_object *_o = parse_window_size(pss->buffer + 1, pss->len - 1, &pss->process->columns, &pss->process->rows);
+            struct json_object *_p = NULL;
+            if (json_object_object_get_ex(_o, "xpixel", &_p)) pss->process->xpixel = (uint16_t)json_object_get_int(_p);
+            if (json_object_object_get_ex(_o, "ypixel", &_p)) pss->process->ypixel = (uint16_t)json_object_get_int(_p);
+            json_object_put(_o);
+          }
           pty_resize(pss->process);
           break;
         case PAUSE:
diff --git a/src/pty.c b/src/pty.c
index 01e9d6b..e011634 100644
--- a/src/pty.c
+++ b/src/pty.c
@@ -121,13 +121,13 @@ void process_free(pty_process *process) {
 
 void pty_pause(pty_process *process) {
   if (process == NULL) return;
-  if (process->paused) return;
+  process->paused = true;
   uv_read_stop((uv_stream_t *) process->out);
 }
 
 void pty_resume(pty_process *process) {
   if (process == NULL) return;
-  if (!process->paused) return;
+  process->paused = false;
   process->out->data = process;
   uv_read_start((uv_stream_t *) process->out, alloc_cb, read_cb);
 }
@@ -150,7 +150,7 @@ bool pty_resize(pty_process *process) {
   COORD size = {(int16_t) process->columns, (int16_t) process->rows};
   return pResizePseudoConsole(process->pty, size) == S_OK;
 #else
-  struct winsize size = {process->rows, process->columns, 0, 0};
+  struct winsize size = {process->rows, process->columns, process->xpixel, process->ypixel};
   return ioctl(process->pty, TIOCSWINSZ, &size) == 0;
 #endif
 }
