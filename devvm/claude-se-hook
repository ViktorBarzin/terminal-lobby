#!/usr/bin/env bash
# claude-se-hook — terminal-lobby v2 hook bridging Claude Code to the
# session-events service (:7685) that drives the text-mode view.
#
#   session-start -> register (user, tmux session) -> transcript mapping so
#                    /events/<session> can find the transcript to tail.
#   prompt-submit -> re-register when the binding has moved since we last looked.
#   question      -> PermissionRequest for AskUserQuestion (ADR-0034): hand the
#                    question to session-events and wait until the lobby's
#                    question card answers it, then print the decision for the
#                    CLI. The CLI draws its own menu meanwhile and whichever
#                    answers first wins; a 204 means the terminal won, or
#                    nothing could hold the question, and printing nothing
#                    leaves the menu as it is.
#
# Why the second event: the registry is keyed by tmux session NAME, but the name
# is captured once at SessionStart, and a session can be renamed afterwards —
# from the lobby's rename, or by a pre-warmed pool slot being claimed under the
# name the user asked for. Either way the binding kept pointing at the old name
# and /events/<new name> answered "session not registered", so the text-mode
# view went blank for that session until the next Claude start re-registered it.
# Re-checking as the user submits a prompt makes the binding correct by the time
# anything could want to read it, whatever moved the name.
#
# Wired org-wide via /etc/claude-code/managed-settings.json (infra repo),
# alongside claude-tmux-state. Contract with the hook runner:
#   - MUST exit 0 — a non-zero hook exit can block the tool call.
#   - session-start and prompt-submit MUST stay silent — stdout of both is
#     injected into the conversation as context. question prints only the
#     decision session-events hands it, which the CLI reads as the answer.
#   - No-ops outside tmux ($TMUX or $TMUX_PANE unset) — headless / t3 Claude
#     run these too.
#   - session-events unreachable -> connect-timeout fails fast -> silent no-op.
#   - prompt-submit is on the hot path of every turn, so it does no network work
#     unless the (name, transcript) pair actually changed. The last registered
#     pair is remembered in a tmux pane option and checked against the
#     session's stamp, which costs two show-options.
#
# NOTE: the permission-request path (web-mediated PreToolUse permissions) was
# removed 2026-07-21. Routed through the session-events broker, it returned
# "ask" for any session not being watched in text-mode, and a PreToolUse "ask"
# OVERRIDES the allowlist / permission mode — so with v2 paused it forced a
# prompt on every tool call in every session. Only session registration remains.
set -u

# TL_SE_URL is the test harness's override; the managed settings set nothing.
SE="${TL_SE_URL:-http://localhost:7685}"
event="${1:-}"

# Outside a tmux pane there is no lobby session to bind to.
[ -n "${TMUX:-}" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0
command -v jq   >/dev/null 2>&1 || exit 0
command -v curl >/dev/null 2>&1 || exit 0

# Only the pane's own claude registers. A claude started from inside the
# session's own work (an agent's Bash running `claude -p`) inherits TMUX_PANE
# and fires SessionStart and UserPromptSubmit here too, which bound the session
# to the nested claude's transcript: the text view then showed that one-prompt
# conversation and none of the session's own agents. The pane's own claude is
# the only claude between this hook and the tmux server, so a second one above
# it means a nested start. Same check as claude-tmux-state; anything /proc does
# not answer counts as the pane's own.
nested_claude() {
    local p=$PPID owners=0 comm stat
    while :; do
        case "$p" in
        "" | *[!0-9]* | 0 | 1) return 1 ;;
        esac
        read -r comm 2>/dev/null <"/proc/$p/comm" || return 1
        case "$comm" in
        "tmux: server") return 1 ;;
        claude | pi) owners=$((owners + 1)) ;;
        esac
        [ "$owners" -ge 2 ] && return 0
        read -r stat 2>/dev/null <"/proc/$p/stat" || return 1
        # "pid (comm) state ppid ...", counted from the last ") ".
        stat="${stat##*) }"
        stat="${stat#* }"
        p="${stat%% *}"
    done
}
nested_claude && exit 0

# The session is the one holding THIS pane, asked for by pane id. An untargeted
# `tmux display -p '#S'` does not fail when the pane has gone: tmux answers with
# the most recently active session instead. A speculative pool slot released
# while its Claude was still starting then registered its never-written
# transcript against whichever session was busiest, and that session's Text
# view went empty (emo's marinov and monitors, 2026-09-28). A dead pane answers
# nothing here, and nothing is registered.
tmux_session="$(tmux display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)"
[ -n "$tmux_session" ] || exit 0

input="$(cat)"

# POST the (user, session_id, cwd, transcript, tmux_session) binding. Idempotent
# server-side and safe to repeat: a binding that has not moved re-registers the
# same mapping.
#
# transcript_path is the field that LOCATES the file. The service used to derive
# it from cwd, which assumes Claude Code files a session under the directory it
# is working in; it files it under the directory it was STARTED in. So a session
# that cds — into a worktree, into a sub-project — and re-registers was stamped
# with a path that does not exist, and its Text view tailed nothing for the rest
# of its life (2 of 16 live sessions on this box, measured 2026-08-28). The
# harness names the real file in every hook payload; pass it on and stop
# guessing. cwd still rides along for a service older than the field.
register() {
    jq -nc --arg u "$USER" --arg s "$1" --arg c "$2" --arg p "$3" --arg t "$tmux_session" \
        '{user:$u, session_id:$s, cwd:$c, transcript_path:$p, tmux_session:$t}' 2>/dev/null \
      | curl -s --connect-timeout 2 --max-time 3 -X POST --data-binary @- \
        "$SE/hooks/session-start" >/dev/null 2>&1 || true
    # Remember what we registered so prompt-submit can tell "unchanged" from
    # "moved" without asking the service. Pane-scoped, so it cannot leak between
    # two Claude processes sharing a session. The TRANSCRIPT is part of the key:
    # a session whose file moved — or one registered by an older hook that never
    # sent the path — re-registers on its next prompt instead of staying wrong
    # until Claude is restarted.
    tmux set-option -t "${TMUX_PANE:-}" @se_registered "$tmux_session:$1:$3" \
        >/dev/null 2>&1 || true
}

case "$event" in
session-start)
    sid="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null || true)"
    cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null || true)"
    tp="$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null || true)"
    [ -n "$cwd" ] || cwd="$PWD"
    [ -n "$sid" ] || exit 0
    register "$sid" "$cwd" "$tp"
    ;;
prompt-submit)
    # No TMUX_PANE means no place to remember the last binding, and re-POSTing
    # on every single turn is not worth it — SessionStart already covers the
    # ordinary case where nothing is renamed.
    [ -n "${TMUX_PANE:-}" ] || exit 0
    sid="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null || true)"
    [ -n "$sid" ] || exit 0
    tp="$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null || true)"
    prev="$(tmux show-option -qv -t "$TMUX_PANE" @se_registered 2>/dev/null || true)"
    # The session's own stamp is checked as well as the pane's record. The two
    # disagree when something registered against this session from outside
    # the pane, and trusting the pane alone left that stamp wrong until Claude
    # restarted. Only a hook that sent a path can compare it.
    stamp="$(tmux show-option -qv -t "=$tmux_session:" @claude_transcript 2>/dev/null || true)"
    [ "$prev" = "$tmux_session:$sid:$tp" ] && { [ -z "$tp" ] || [ "$stamp" = "$tp" ]; } && exit 0
    cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null || true)"
    [ -n "$cwd" ] || cwd="$PWD"
    register "$sid" "$cwd" "$tp"
    ;;
question)
    # When this hook first ran, carried on every retry so a hold that begins
    # after a session-events restart can tell a result the terminal wrote in
    # the gap from an older call asking the same thing.
    since="$(date +%s%3N)"
    body="$(printf '%s' "$input" | jq -c --arg u "$USER" --arg t "$tmux_session" --argjson s "$since" \
        '. + {user:$u, tmux_session:$t, since:$s}' 2>/dev/null || true)"
    [ -n "$body" ] || exit 0
    out="$(mktemp)" code="$(mktemp)"
    pid=""
    # The CLI SIGTERMs a hook that reaches its timeout. curl goes with it, so
    # the held question is withdrawn rather than left waiting on a dead hook.
    trap '[ -n "$pid" ] && kill "$pid" 2>/dev/null; rm -f "$out" "$code"; exit 0' TERM INT HUP
    trap 'rm -f "$out" "$code"' EXIT
    # A restarting session-events refuses connections for a few seconds; ask
    # again until it is back, but give up on one that stays away, since the CLI
    # does not stop this hook when the terminal answers first.
    give_up=$(( $(date +%s) + 600 ))
    while :; do
        printf '%s' "$body" | curl -s --connect-timeout 2 -o "$out" -w '%{http_code}' \
            -X POST -H 'Content-Type: application/json' --data-binary @- \
            "$SE/hooks/question" >"$code" 2>/dev/null &
        pid=$!
        wait "$pid"
        pid=""
        case "$(cat "$code" 2>/dev/null)" in
        200) cat "$out"; exit 0 ;;
        000|502|503|504)
            [ "$(date +%s)" -lt "$give_up" ] || exit 0
            sleep 2 ;;
        *) exit 0 ;; # 204, or a service without the route: the menu stays
        esac
    done
    ;;
esac
exit 0
