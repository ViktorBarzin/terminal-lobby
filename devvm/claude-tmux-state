#!/bin/sh
# claude-tmux-state — Claude Code hook that stamps the current tmux
# session with @claude_state so the terminal-lobby sidebar can show a
# per-session indicator (ADR-0001), and with @claude_bg so that indicator
# survives the main turn ending while background work is still running
# (docs/plans/2026-09-04-background-work-session-state-design.md).
#
# Wired org-wide via /etc/claude-code/managed-settings.json (infra repo):
#
#   UserPromptSubmit / PreToolUse / PostToolUse  -> running
#   Stop / SessionStart                          -> done
#   SessionEnd                                   -> clear (unset)
#   Notification                                 -> notify (classified below)
#
# The argv word is the COARSE mode; three events share "running" and two share
# "done", so the fine branch reads `hook_event_name` off the payload. A payload
# without that field falls back to the argv word alone, which is exactly the
# behaviour this script had before 2026-09-04.
#
# Contract with the hook runner:
#   - MUST stay silent: stdout of several hook events is injected into
#     the conversation as context.
#   - MUST exit 0: a non-zero PreToolUse exit blocks the tool call.
#   - No-ops outside tmux ($TMUX unset) — t3-serve and headless Claude
#     instances run these same org-wide hooks.
#   - No jq, no forks that are not tmux: PostToolUse fires on every tool call
#     in every session on the box. Field extraction is shell parameter
#     expansion, which costs nothing.
set -u

[ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

mode="${1:-}"

stamp() {
    # Usage event (docs/adr/0006-usage-telemetry.md) on a REAL transition only.
    # This hook fires on every UserPromptSubmit AND every PreToolUse, all of
    # which stamp "running" — emitting per call would put thousands of
    # no-op events a day into a shared 30-day log store. Reading the current
    # value first costs one tmux show-option, which this script already does
    # elsewhere. Only $1 (a fixed word from the case below) and the tmux
    # session name are interpolated; tmux rejects newlines in session names.
    local prev
    prev="$(tmux show-option -qv -t "$TMUX_PANE" @claude_state 2>/dev/null || true)"
    tmux set-option -t "$TMUX_PANE" @claude_state "$1" >/dev/null 2>&1 || true
    if [ "$prev" != "$1" ]; then
        logger -t claude-tmux-state "TLEVENT {\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"event.name\":\"claude.state_changed\",\"service.name\":\"claude-tmux-state\",\"user.id\":\"$(id -un)\",\"attrs\":{\"tl.session\":\"$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null)\",\"tl.from\":\"${prev:-none}\",\"tl.to\":\"$1\",\"tl.client\":\"hook\"}}" 2>/dev/null || true
    fi
}

# ---- SessionEnd -----------------------------------------------------------
# Handled before stdin is read: it needs nothing off the wire, and it is the
# one event where the pane may already be going away.
if [ "$mode" = clear ]; then
    tmux set-option -u -t "$TMUX_PANE" @claude_state >/dev/null 2>&1 || true
    tmux set-option -u -t "$TMUX_PANE" @claude_bg >/dev/null 2>&1 || true
    # Record that this ending was DELIBERATE, so tl-session-watch does not
    # report it as a lost session (2026-09-03).
    #
    # Why it is needed: the watcher calls a vanished session a death unless
    # something says otherwise, and the only thing that said otherwise was a
    # tmux-persist tombstone. tmux-api's DELETE handler writes one, which
    # covers a kill from the lobby and from t3-sync, since that goes through
    # the same endpoint. Nothing wrote one when a user simply typed /exit:
    # claude ends, its pane exits, the session closes, and tmux-api never
    # hears about it. That paged emo at 08:25 on 2026-09-03 for tidying up.
    #
    # Why this is safe as a death signal: SessionEnd is a hook, and a hook
    # cannot run when the process is SIGKILLed or OOM-killed. So the record
    # exists exactly when the ending was orderly, and the deaths worth
    # alerting on still have nothing to explain them.
    #
    # /run/user/<uid>: systemd already owns it, mode 0700 as this user, so no
    # sudo grant is needed and no other user can forge a row that silences an
    # alert. Best-effort throughout — this hook must never fail a session exit.
    ce_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ -d "$ce_dir" ]; then
        ce_sess="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true)"
        # Same `<session>\t<epoch>` rows as the tombstone file, so the watcher
        # parses both with one function. Only the empty name is rejected: a
        # separator inside the name would corrupt the row, and neither can get
        # there — tmux rejects newlines in session names, and every name the
        # lobby creates passes tmux-api's sessionNameRe (alnum, '_' and '-').
        # An earlier version also tried to reject tabs and newlines with
        # *"$(printf '\n')"*, which is a trap: command substitution strips the
        # trailing newline, so the pattern collapsed to *""* and matched every
        # name, silently writing nothing at all.
        if [ -n "$ce_sess" ]; then
            printf '%s\t%s\n' "$ce_sess" "$(date -u +%s)" \
                >> "$ce_dir/tl-clean-exit.tsv" 2>/dev/null || true
        fi
    fi
    exit 0
fi

payload="$(cat 2>/dev/null || true)"

# ---- Reading the payload --------------------------------------------------
# Both helpers write their answer to $jv rather than echoing it: a command
# substitution is a fork, and these run on the hot path.

jv=""

# json_field extracts a string field's value. Hook payloads are compact JSON
# with no whitespace ("agent_id":"a1cbb…"), verified against claude 2.1.260 on
# 2026-09-04, which is what lets parameter expansion do this without jq.
json_field() {
    jv=""
    case "$payload" in
    *"\"$1\":\""*)
        jv="${payload#*\"$1\":\"}"
        jv="${jv%%\"*}"
        ;;
    esac
}

# json_tag extracts the text of an XML element inside the payload. The harness
# writes its bookkeeping as markup in the prompt, and <task-id> is the one
# thing that says WHICH background task just reported (sessionio/harness.go
# renders the same markup for the Text view).
json_tag() {
    jv=""
    case "$payload" in
    *"<$1>"*)
        jv="${payload#*<$1>}"
        jv="${jv%%</$1>*}"
        ;;
    esac
}

# An id that is not [A-Za-z0-9_-] is rejected rather than stored: it lands in a
# tmux option value and is later matched as a shell pattern, so the charset is
# the whole of its validation.
id_ok() {
    case "$1" in
    "" | *[!A-Za-z0-9_-]*) return 1 ;;
    esac
    return 0
}

# ---- The outstanding-work set ---------------------------------------------
# @claude_bg holds space-separated `<kind>:<id>` tokens: `a` an agent, `b` a
# background command, `w` a workflow. Empty means the session owes nothing and
# Stop may finish it.

bg=""
bg_read() { bg="$(tmux show-option -qv -t "$TMUX_PANE" @claude_bg 2>/dev/null || true)"; }

bg_write() {
    if [ -z "$1" ]; then
        tmux set-option -u -t "$TMUX_PANE" @claude_bg >/dev/null 2>&1 || true
    else
        tmux set-option -t "$TMUX_PANE" @claude_bg "$1" >/dev/null 2>&1 || true
    fi
}

# bg_add is a no-op for an id already present, so a re-fired hook cannot double
# count. The cap is not an expiry — there is deliberately none (2026-09-04) —
# it bounds an option value that nothing else bounds; 64 is far past any real
# turn, where the count is single digits.
bg_add() {
    bg_read
    case " $bg " in *" $1 "*) return 0 ;; esac
    n=0
    for t in $bg; do n=$((n + 1)); done
    [ "$n" -ge 64 ] && return 0
    if [ -z "$bg" ]; then bg_write "$1"; else bg_write "$bg $1"; fi
}

# bg_del retires one id whatever kind it was recorded as: a task-notification
# names the id and nothing else.
bg_del() {
    bg_read
    [ -n "$bg" ] || return 0
    kept=""
    for t in $bg; do
        case "$t" in *":$1") continue ;; esac
        if [ -z "$kept" ]; then kept="$t"; else kept="$kept $t"; fi
    done
    [ "$kept" != "$bg" ] && bg_write "$kept"
    return 0
}

# bg_prune drops every outstanding id the harness no longer lists as a task.
#
# This is the only reliable drain. bg_del runs off a UserPromptSubmit carrying
# <task-notification>, and that fires ONLY when the task finishes BETWEEN turns.
# A task that finishes mid-turn has its notification absorbed into the running
# turn: the transcript records `queue-operation` enqueue and then remove with
# reason `absorbed_mid_turn`, no UserPromptSubmit fires at all, and the id used
# to sit in @claude_bg for good — so the session read `running` with nothing
# running, and handle_notify below also stopped promoting it to `awaiting`.
#
# Measured over 122 transcripts on 2026-09-04, how a completion reached the
# session: background commands 258 as a prompt against 765 absorbed or silently
# removed; agents 57 against 35; workflows 36 against 18. Of 56 tasks stopped
# with the TaskStop tool, 42 never enqueued a notification at all.
#
# The Stop payload carries `background_tasks`, the harness's own live registry —
# `{"id":…,"type":"shell"|"subagent","status":"running",…}` — and it is
# authoritative: measured live the same day, a task that finished, and a task
# stopped with TaskStop, both left the list at once. Stop is the only event that
# carries the field, which is also the only event that has to decide.
#
# Two deliberate limits. A WORKFLOW is never pruned: the two kinds seen in a real
# payload are "shell" and "subagent", and whether a running Workflow appears at
# all is unmeasured, so pruning one would risk reporting done in the middle of a
# half-hour run. And a payload with no `background_tasks` field prunes nothing,
# so an older harness keeps the behaviour this script had before.
#
# The match is biased on purpose. `"id":"<id>"` can in principle hit something
# outside the array, which KEEPS an id — the session stays running one turn
# longer and the next Stop corrects it. Failing the other way would report a
# session done while its work ran, which is the bug this whole option exists to
# prevent.
bg_prune() {
    case "$payload" in
    *'"background_tasks":['*) ;;
    *) return 0 ;;
    esac
    bg_read
    [ -n "$bg" ] || return 0
    kept=""
    for t in $bg; do
        keep=0
        case "$t" in
        w:*) keep=1 ;;
        *)
            id="${t#*:}"
            case "$payload" in *"\"id\":\"$id\""*) keep=1 ;; esac
            ;;
        esac
        if [ "$keep" = 1 ]; then
            if [ -z "$kept" ]; then kept="$t"; else kept="$kept $t"; fi
        fi
    done
    [ "$kept" != "$bg" ] && bg_write "$kept"
    return 0
}

# record_launch adds the task a PostToolUse just started, if it started one.
# Three tools, three field names, all carrying the id that the eventual
# task-notification will name:
#
#   Agent (background)  tool_response.agentId,           status async_launched
#   Workflow            tool_response.taskId,            status async_launched
#   Bash run_in_background  tool_response.backgroundTaskId
record_launch() {
    case "$payload" in
    *'"status":"async_launched"'*)
        json_field agentId
        if id_ok "$jv"; then
            bg_add "a:$jv"
            return 0
        fi
        json_field taskId
        id_ok "$jv" && bg_add "w:$jv"
        return 0
        ;;
    esac
    case "$payload" in
    *'"backgroundTaskId":"'*)
        json_field backgroundTaskId
        id_ok "$jv" && bg_add "b:$jv"
        ;;
    esac
}

# ---- Notification ---------------------------------------------------------
# Notifications are not all "awaiting input". BLOCKED asks — permission /
# approval dialogs and "needs your input" — always stamp awaiting (amber): the
# turn cannot proceed without the user, and that is true whether the block is
# the main thread's or a background agent's. The IDLE-REMINDER wording
# ("waiting for your input") is different: after a COMPLETED turn it is just
# Claude politely idling, and stamping awaiting there repainted every finished
# session amber ~a minute after it went green (Viktor: "the nub is yellow-ish
# when the agent is completed"). So the idle wording — and any other
# unrecognized wording — promotes ONLY from a session that is genuinely
# mid-turn: state running AND nothing outstanding. A session held at running by
# background work is not mid-turn, and a done session stays done. Matching
# stays case-insensitive since Claude's phrasing drifts between versions.
handle_notify() {
    msg_lc="$(printf '%s' "$payload" | tr '[:upper:]' '[:lower:]')"
    case "$msg_lc" in
    *permission* | *approval* | *"needs your input"*)
        stamp awaiting
        ;;
    *)
        cur="$(tmux show-option -qv -t "$TMUX_PANE" @claude_state 2>/dev/null || true)"
        [ "$cur" = "running" ] || return 0
        bg_read
        [ -n "$bg" ] && return 0
        stamp awaiting
        ;;
    esac
}

# ---- Dispatch -------------------------------------------------------------

json_field hook_event_name
event="$jv"
json_field agent_id
agent="$jv"

case "$event" in
UserPromptSubmit)
    # A completing background task re-enters the session as a synthetic prompt
    # carrying its own markup. That retires one id. Anything else is a person
    # typing, which re-derives the set from nothing: with no expiry on an id,
    # interacting with a session is what unsticks one whose set went stale
    # (decided 2026-09-04). The accepted cost is that a prompt sent while a
    # long workflow is genuinely running reports done early.
    case "$payload" in
    *'"prompt":"<task-notification>'*)
        json_tag task-id
        id_ok "$jv" && bg_del "$jv"
        ;;
    *)
        bg_write ""
        ;;
    esac
    stamp running
    ;;
PreToolUse)
    # A subagent's own tool calls reach THIS session's hooks carrying agent_id
    # (measured 2026-09-04). Stamping on them made the dot alternate between
    # done and running for as long as a background agent worked, which is why
    # the wrong colour was intermittent rather than constant.
    [ -n "$agent" ] && exit 0
    stamp running
    ;;
PostToolUse)
    [ -n "$agent" ] && exit 0
    record_launch
    stamp running
    ;;
Stop)
    # Stop is the main thread stopping talking, not the end of the turn's work.
    # What the harness still lists decides; the accumulated set only carries the
    # KIND of each id, which the payload does not give us for a workflow.
    bg_prune
    bg_read
    if [ -n "$bg" ]; then stamp running; else stamp done; fi
    ;;
SessionStart)
    # A fresh claude owes nothing, whatever the option survived from the
    # process that died in this session.
    bg_write ""
    stamp done
    ;;
Notification)
    handle_notify
    ;;
"")
    # No hook_event_name: a harness older than this script, or an event fired
    # by something else. Fall back to the argv word alone, which is what this
    # script did before background work was tracked.
    case "$mode" in
    running | done) stamp "$mode" ;;
    awaiting) stamp awaiting ;;
    notify) handle_notify ;;
    esac
    ;;
*)
    # A wired event this script has no rule for. Honour the argv word so a
    # future infra change cannot silently stop the indicator working.
    case "$mode" in
    running | done) stamp "$mode" ;;
    awaiting) stamp awaiting ;;
    notify) handle_notify ;;
    esac
    ;;
esac

exit 0
