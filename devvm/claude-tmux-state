#!/bin/sh
# claude-tmux-state — Claude Code hook that stamps the current tmux
# session with @claude_state so the terminal-lobby sidebar can show a
# per-session indicator (ADR-0001). Wired org-wide via
# /etc/claude-code/managed-settings.json (infra repo):
#
#   UserPromptSubmit / PreToolUse / PostToolUse  -> running
#   Stop / SessionStart                          -> done
#   SessionEnd                                   -> clear (unset)
#   Notification                                 -> notify (classified below)
#
# Contract with the hook runner:
#   - MUST stay silent: stdout of several hook events is injected into
#     the conversation as context.
#   - MUST exit 0: a non-zero PreToolUse exit blocks the tool call.
#   - No-ops outside tmux ($TMUX unset) — t3-serve and headless Claude
#     instances run these same org-wide hooks.
set -u

[ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

mode="${1:-}"

stamp() {
    # Usage event (docs/adr/0006-usage-telemetry.md) on a REAL transition only.
    # This hook fires on every UserPromptSubmit AND every PreToolUse, all of
    # which stamp "running" — emitting per call would put thousands of
    # no-op events a day into a shared 30-day log store. Reading the current
    # value first costs one tmux show-option, which this script already does
    # elsewhere. Only $1 (a fixed word from the case below) and the tmux
    # session name are interpolated; tmux rejects newlines in session names.
    local prev
    prev="$(tmux show-option -qv -t "$TMUX_PANE" @claude_state 2>/dev/null || true)"
    tmux set-option -t "$TMUX_PANE" @claude_state "$1" >/dev/null 2>&1 || true
    if [ "$prev" != "$1" ]; then
        logger -t claude-tmux-state "TLEVENT {\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"event.name\":\"claude.state_changed\",\"service.name\":\"claude-tmux-state\",\"user.id\":\"$(id -un)\",\"attrs\":{\"tl.session\":\"$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null)\",\"tl.from\":\"${prev:-none}\",\"tl.to\":\"$1\",\"tl.client\":\"hook\"}}" 2>/dev/null || true
    fi
}

case "$mode" in
running|done)
    stamp "$mode"
    ;;
awaiting)
    stamp awaiting
    ;;
clear)
    tmux set-option -u -t "$TMUX_PANE" @claude_state >/dev/null 2>&1 || true
    # Record that this ending was DELIBERATE, so tl-session-watch does not
    # report it as a lost session (2026-09-03).
    #
    # Why it is needed: the watcher calls a vanished session a death unless
    # something says otherwise, and the only thing that said otherwise was a
    # tmux-persist tombstone. tmux-api's DELETE handler writes one, which
    # covers a kill from the lobby and from t3-sync, since that goes through
    # the same endpoint. Nothing wrote one when a user simply typed /exit:
    # claude ends, its pane exits, the session closes, and tmux-api never
    # hears about it. That paged emo at 08:25 on 2026-09-03 for tidying up.
    #
    # Why this is safe as a death signal: SessionEnd is a hook, and a hook
    # cannot run when the process is SIGKILLed or OOM-killed. So the record
    # exists exactly when the ending was orderly, and the deaths worth
    # alerting on still have nothing to explain them.
    #
    # /run/user/<uid>: systemd already owns it, mode 0700 as this user, so no
    # sudo grant is needed and no other user can forge a row that silences an
    # alert. Best-effort throughout — this hook must never fail a session exit.
    ce_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ -d "$ce_dir" ]; then
        ce_sess="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true)"
        # Same `<session>\t<epoch>` rows as the tombstone file, so the watcher
        # parses both with one function. Only the empty name is rejected: a
        # separator inside the name would corrupt the row, and neither can get
        # there — tmux rejects newlines in session names, and every name the
        # lobby creates passes tmux-api's sessionNameRe (alnum, '_' and '-').
        # An earlier version also tried to reject tabs and newlines with
        # *"$(printf '\n')"*, which is a trap: command substitution strips the
        # trailing newline, so the pattern collapsed to *""* and matched every
        # name, silently writing nothing at all.
        if [ -n "$ce_sess" ]; then
            printf '%s\t%s\n' "$ce_sess" "$(date -u +%s)" \
                >> "$ce_dir/tl-clean-exit.tsv" 2>/dev/null || true
        fi
    fi
    ;;
notify)
    # Notifications are not all "awaiting input". BLOCKED asks — permission
    # / approval dialogs and "needs your input" — always stamp awaiting
    # (amber): the turn cannot proceed without the user. The IDLE-REMINDER
    # wording ("waiting for your input") is different: after a COMPLETED
    # turn it is just Claude politely idling, and stamping awaiting there
    # repainted every finished session amber ~a minute after it went green
    # (Viktor: "the nub is yellow-ish when the agent is completed"). So the
    # idle wording — and any other unrecognized wording — promotes ONLY
    # from running (Claude stopped mid-turn: genuinely blocked); a done
    # session STAYS done (green). Matching stays case-insensitive since
    # Claude's phrasing drifts between versions.
    msg="$(cat 2>/dev/null || true)"
    msg_lc="$(printf '%s' "$msg" | tr '[:upper:]' '[:lower:]')"
    case "$msg_lc" in
    *permission*|*approval*|*"needs your input"*)
        stamp awaiting
        ;;
    *)
        cur="$(tmux show-option -qv -t "$TMUX_PANE" @claude_state 2>/dev/null || true)"
        [ "$cur" = "running" ] && stamp awaiting
        ;;
    esac
    ;;
esac

exit 0
