#!/bin/sh
# claude-tmux-state — Claude Code hook that stamps the current tmux
# session with @claude_state so the terminal-lobby sidebar can show a
# per-session indicator (ADR-0001), and with @claude_bg so that indicator
# survives the main turn ending while background work is still running
# (docs/plans/2026-09-04-background-work-session-state-design.md).
#
# Wired org-wide via /etc/claude-code/managed-settings.json (infra repo):
#
#   UserPromptSubmit / PreToolUse / PostToolUse  -> running
#   SubagentStart                                -> running
#   Stop / SessionStart                          -> done
#   SessionEnd                                   -> clear (unset)
#   Notification                                 -> notify (classified below)
#   TeammateIdle                                 -> teammate-idle (no coarse
#                                                   meaning: an older copy of
#                                                   this script does nothing
#                                                   with the word, which is
#                                                   the right fallback)
#
# The argv word is the COARSE mode; three events share "running" and two share
# "done", so the fine branch reads `hook_event_name` off the payload. A payload
# without that field falls back to the argv word alone, which is exactly the
# behaviour this script had before 2026-09-04.
#
# Contract with the hook runner:
#   - MUST stay silent: stdout of several hook events is injected into
#     the conversation as context.
#   - MUST exit 0: a non-zero PreToolUse exit blocks the tool call.
#   - No-ops outside tmux ($TMUX unset) — t3-serve and headless Claude
#     instances run these same org-wide hooks.
#   - No jq, no forks that are not tmux: PostToolUse fires on every tool call
#     in every session on the box. Field extraction is shell parameter
#     expansion, which costs nothing.
set -u

[ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

mode="${1:-}"

stamp() {
    # Usage event (docs/adr/0006-usage-telemetry.md) on a REAL transition only.
    # This hook fires on every UserPromptSubmit AND every PreToolUse, all of
    # which stamp "running" — emitting per call would put thousands of
    # no-op events a day into a shared 30-day log store. Reading the current
    # value first costs one tmux show-option, which this script already does
    # elsewhere.
    #
    # Every value spliced into the line below is folded to [A-Za-z0-9_-] first,
    # the same charset id_ok enforces further down. Newlines were never the
    # exposure here; quotes were, and the two sources differ in how far a quote
    # gets (both measured on a private tmux socket, 2026-09-05):
    #
    #   the session name       `tmux rename-session` keeps a quote, a brace and
    #                          a comma verbatim but maps ':' and '.' to '_', so
    #                          the record stops decoding rather than carrying a
    #                          forged field. Integrity loss, not attribution.
    #   @claude_state          a tmux OPTION value, so nothing is mapped. Set
    #                          from any shell on the user's own tmux server to
    #                            x"},"user.id":"victim","z":{"a":"b
    #                          it closed the attrs object and produced a VALID
    #                          record whose top-level user.id read `victim`,
    #                          because encoding/json takes the last duplicate
    #                          key. That is a row in the shared 30-day store
    #                          attributed to someone else.
    #
    # Folding is a case statement rather than jq because this runs on every
    # state transition in every session on the box.
    prev="$(tmux show-option -qv -t "$TMUX_PANE" @claude_state 2>/dev/null || true)"
    tmux set-option -t "$TMUX_PANE" @claude_state "$1" >/dev/null 2>&1 || true
    if [ "$prev" != "$1" ]; then
        sess="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true)"
        case "$sess" in
        "" | *[!A-Za-z0-9_-]*) sess=invalid ;;
        esac
        from="${prev:-none}"
        case "$from" in
        *[!A-Za-z0-9_-]*) from=invalid ;;
        esac
        logger -t claude-tmux-state "TLEVENT {\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"event.name\":\"claude.state_changed\",\"service.name\":\"claude-tmux-state\",\"user.id\":\"$(id -un)\",\"attrs\":{\"tl.session\":\"$sess\",\"tl.from\":\"$from\",\"tl.to\":\"$1\",\"tl.client\":\"hook\"}}" 2>/dev/null || true
    fi
}

# ---- SessionEnd -----------------------------------------------------------
# Handled before stdin is read: it needs nothing off the wire, and it is the
# one event where the pane may already be going away.
if [ "$mode" = clear ]; then
    tmux set-option -u -t "$TMUX_PANE" @claude_state >/dev/null 2>&1 || true
    tmux set-option -u -t "$TMUX_PANE" @claude_bg >/dev/null 2>&1 || true
    # Record that this ending was DELIBERATE, so tl-session-watch does not
    # report it as a lost session (2026-09-03).
    #
    # Why it is needed: the watcher calls a vanished session a death unless
    # something says otherwise, and the only thing that said otherwise was a
    # tmux-persist tombstone. tmux-api's DELETE handler writes one, which
    # covers a kill from the lobby and from t3-sync, since that goes through
    # the same endpoint. Nothing wrote one when a user simply typed /exit:
    # claude ends, its pane exits, the session closes, and tmux-api never
    # hears about it. That paged emo at 08:25 on 2026-09-03 for tidying up.
    #
    # Why this is safe as a death signal: SessionEnd is a hook, and a hook
    # cannot run when the process is SIGKILLed or OOM-killed. So the record
    # exists exactly when the ending was orderly, and the deaths worth
    # alerting on still have nothing to explain them.
    #
    # /run/user/<uid>: systemd already owns it, mode 0700 as this user, so no
    # sudo grant is needed and no other user can forge a row that silences an
    # alert. Best-effort throughout — this hook must never fail a session exit.
    ce_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ -d "$ce_dir" ]; then
        ce_sess="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true)"
        # Same `<session>\t<epoch>` rows as the tombstone file, so the watcher
        # parses both with one function. Only the empty name is rejected: a
        # separator inside the name would corrupt the row, and neither can get
        # there — tmux rejects newlines in session names, and every name the
        # lobby creates passes tmux-api's sessionNameRe (alnum, '_' and '-').
        # An earlier version also tried to reject tabs and newlines with
        # *"$(printf '\n')"*, which is a trap: command substitution strips the
        # trailing newline, so the pattern collapsed to *""* and matched every
        # name, silently writing nothing at all.
        if [ -n "$ce_sess" ]; then
            printf '%s\t%s\n' "$ce_sess" "$(date -u +%s)" \
                >> "$ce_dir/tl-clean-exit.tsv" 2>/dev/null || true
        fi
    fi
    exit 0
fi

payload="$(cat 2>/dev/null || true)"

# ---- Reading the payload --------------------------------------------------
# Both helpers write their answer to $jv rather than echoing it: a command
# substitution is a fork, and these run on the hot path.

jv=""

# json_field extracts a string field's value. Hook payloads are compact JSON
# with no whitespace ("agent_id":"a1cbb…"), verified against claude 2.1.260 on
# 2026-09-04, which is what lets parameter expansion do this without jq.
json_field() {
    jv=""
    case "$payload" in
    *"\"$1\":\""*)
        jv="${payload#*\""$1"\":\"}"
        jv="${jv%%\"*}"
        ;;
    esac
}

# json_tag extracts the text of an XML element inside the payload. The harness
# writes its bookkeeping as markup in the prompt, and <task-id> is the one
# thing that says WHICH background task just reported (sessionio/harness.go
# renders the same markup for the Text view).
json_tag() {
    jv=""
    case "$payload" in
    *"<$1>"*)
        jv="${payload#*<"$1">}"
        jv="${jv%%</"$1">*}"
        ;;
    esac
}

# An id that is not [A-Za-z0-9_-] is rejected rather than stored: it lands in a
# tmux option value and is later matched as a shell pattern, so the charset is
# the whole of its validation.
id_ok() {
    case "$1" in
    "" | *[!A-Za-z0-9_-]*) return 1 ;;
    esac
    return 0
}

# ---- The outstanding-work set ---------------------------------------------
# @claude_bg holds space-separated `<kind>:<id>` tokens: `a` a background
# subagent, `b` a background command, `w` a workflow, `t` a teammate. Empty
# means the session owes nothing and Stop may finish it.
#
# The first three are keyed by the harness's own task id and re-derived from
# its registry at every Stop. A teammate is keyed by its NAME instead, because
# the registry cannot say whether one is working (bg_sync), and the name is
# what both events that can — SubagentStart and TeammateIdle — carry.

bg=""
bg_read() { bg="$(tmux show-option -qv -t "$TMUX_PANE" @claude_bg 2>/dev/null || true)"; }

bg_write() {
    if [ -z "$1" ]; then
        tmux set-option -u -t "$TMUX_PANE" @claude_bg >/dev/null 2>&1 || true
    else
        tmux set-option -t "$TMUX_PANE" @claude_bg "$1" >/dev/null 2>&1 || true
    fi
}

# bg_add is a no-op for an id already present, so a re-fired hook cannot double
# count. The cap is not an expiry — there is deliberately none (2026-09-04) —
# it bounds an option value that nothing else bounds; 64 is far past any real
# turn, where the count is single digits.
bg_add() {
    bg_read
    case " $bg " in *" $1 "*) return 0 ;; esac
    n=0
    for t in $bg; do n=$((n + 1)); done
    [ "$n" -ge 64 ] && return 0
    if [ -z "$bg" ]; then bg_write "$1"; else bg_write "$bg $1"; fi
}

# bg_del retires one id whatever kind it was recorded as: a task-notification
# names the id and nothing else.
bg_del() {
    bg_read
    [ -n "$bg" ] || return 0
    kept=""
    for t in $bg; do
        case "$t" in *":$1") continue ;; esac
        if [ -z "$kept" ]; then kept="$t"; else kept="$kept $t"; fi
    done
    [ "$kept" != "$bg" ] && bg_write "$kept"
    return 0
}

# bg_sync rebuilds the outstanding set from `background_tasks`, the harness's
# own live registry of what this session started. Stop is the only event that
# carries the field, and the only one that has to decide.
#
# It READS the registry rather than reconciling against it, which is the
# 2026-09-12 change. A one-way prune can only ever remove an id that a launch
# recorded, so anything this script did not recognise at launch time was
# invisible to it for the whole run; reading the list instead picks the work up
# at the first Stop, whatever started it. That covers a compaction, an
# interrupt, and a claude restarted under the same tmux session.
#
# Three kinds are taken from the list, and the fourth is deliberately not:
#
#   shell, subagent, workflow   listed while they work and gone the moment they
#                               finish or are stopped with TaskStop (measured
#                               2026-09-04 and again on 2.1.269, 2026-09-12)
#   teammate                    listed as "running" for as long as the teammate
#                               EXISTS. Measured three times on 2026-09-12, the
#                               last 3m30s after the teammate had answered and
#                               the harness's own bar showed it "idle"
#
# So a teammate is carried here rather than derived: the `t:` tokens already in
# the set survive a sync, and SubagentStart and TeammateIdle are what add and
# retire them. They are dropped only when the registry lists no teammate at
# all, which is the session having disbanded the team.
#
# For the same reason a type this script does not know is skipped rather than
# assumed to be work. Guessing the other way costs more than a late green dot:
# a session stuck at running refuses the model picker ("the session is working
# — stop it first") and holds a T3 attach pin open, and nothing retires the id
# that did it, since there is deliberately no expiry (2026-09-04). A new kind
# belongs here once someone has watched what its status does when it finishes.
#
# Why the list can be believed for the three: the drain it replaces cannot.
# bg_del runs off a UserPromptSubmit carrying <task-notification>, which fires
# ONLY when the task finishes BETWEEN turns. Over 122 transcripts on
# 2026-09-04, how a completion reached the session was 258 prompts against 765
# absorbed mid-turn or silently removed for background commands, 57 against 35
# for agents and 36 against 18 for workflows, and 42 of 56 TaskStop kills
# enqueued no notification at all.
#
# The entry shape is compact, with id, type and status in that order for every
# kind seen:
#
#   {"id":"tocihyt26","type":"teammate","status":"running","description":…}
#
# Only that exact prefix counts as work. A quote inside a JSON string is
# escaped, so `"id":"` can only ever be a real key — but it can be the key of
# something that is not a task, and the same payload carries `session_crons`,
# so the type and the status have to sit where the registry puts them before an
# id is taken as outstanding.
#
# One limit remains: a payload with no `background_tasks` field syncs nothing,
# so an older harness keeps the behaviour this script had before.
bg_sync() {
    case "$payload" in
    *'"background_tasks":['*) ;;
    *) return 0 ;;
    esac
    rest="${payload#*\"background_tasks\":[}"
    new=""
    n=0
    team=0
    while [ "$n" -lt 64 ]; do
        case "$rest" in
        *'"id":"'*) ;;
        *) break ;;
        esac
        rest="${rest#*\"id\":\"}"
        id="${rest%%\"*}"
        after="${rest#*\"}"
        id_ok "$id" || continue
        typ="${after#,\"type\":\"}"
        typ="${typ%%\"*}"
        case "$typ" in
        "" | *[!a-z_]*) continue ;;
        esac
        case "$after" in
        ',"type":"'"$typ"'","status":"running"'*) ;;
        *) continue ;;
        esac
        case "$typ" in
        subagent) kind=a ;;
        shell) kind=b ;;
        workflow) kind=w ;;
        teammate)
            team=1
            continue
            ;;
        *) continue ;;
        esac
        case " $new " in *" $kind:$id "*) continue ;; esac
        if [ -z "$new" ]; then new="$kind:$id"; else new="$new $kind:$id"; fi
        n=$((n + 1))
    done
    bg_read
    if [ "$team" = 1 ]; then
        for t in $bg; do
            case "$t" in
            t:*)
                case " $new " in *" $t "*) continue ;; esac
                if [ -z "$new" ]; then new="$t"; else new="$new $t"; fi
                ;;
            esac
        done
    fi
    [ "$new" != "$bg" ] && bg_write "$new"
    return 0
}

# record_launch adds the task a PostToolUse just started, if it started one:
#
#   Agent (background)      tool_response.agentId,   status async_launched
#   Workflow                tool_response.taskId,    status async_launched
#   Bash run_in_background  tool_response.backgroundTaskId
#
# Each carries the id the eventual task-notification will name, so bg_del can
# retire them one by one.
#
# A TEAMMATE is not recorded here, though its launch comes through this same
# event as `{"status":"teammate_spawned","name":"counter",…}`. Adding it would
# be adding an id nothing can take away: its own ids read
# `counter@session-337349ca`, the registry calls the same agent `tocihyt26` and
# goes on calling it running once it is idle, and no notification arrives when
# it finishes. SubagentStart and TeammateIdle are the pair that can, and they
# are wired together — so a box whose managed-settings predates them keeps the
# old behaviour rather than gaining a token that sticks.
record_launch() {
    case "$payload" in
    *'"status":"async_launched"'*)
        json_field agentId
        if id_ok "$jv"; then
            bg_add "a:$jv"
            return 0
        fi
        json_field taskId
        id_ok "$jv" && bg_add "w:$jv"
        return 0
        ;;
    esac
    case "$payload" in
    *'"backgroundTaskId":"'*)
        json_field backgroundTaskId
        id_ok "$jv" && bg_add "b:$jv"
        ;;
    esac
}

# ---- Notification ---------------------------------------------------------
# Notifications are not all "awaiting input". BLOCKED asks — permission /
# approval dialogs and "needs your input" — always stamp awaiting (amber): the
# turn cannot proceed without the user, and that is true whether the block is
# the main thread's or a background agent's. The IDLE-REMINDER wording
# ("waiting for your input") is different: after a COMPLETED turn it is just
# Claude politely idling, and stamping awaiting there repainted every finished
# session amber ~a minute after it went green (Viktor: "the nub is yellow-ish
# when the agent is completed"). So the idle wording — and any other
# unrecognized wording — promotes ONLY from a session that is genuinely
# mid-turn: state running AND nothing outstanding. A session held at running by
# background work is not mid-turn, and a done session stays done. Matching
# stays case-insensitive since Claude's phrasing drifts between versions.
handle_notify() {
    msg_lc="$(printf '%s' "$payload" | tr '[:upper:]' '[:lower:]')"
    case "$msg_lc" in
    *permission* | *approval* | *"needs your input"*)
        stamp awaiting
        ;;
    *)
        cur="$(tmux show-option -qv -t "$TMUX_PANE" @claude_state 2>/dev/null || true)"
        [ "$cur" = "running" ] || return 0
        bg_read
        [ -n "$bg" ] && return 0
        stamp awaiting
        ;;
    esac
}

# ---- Dispatch -------------------------------------------------------------

json_field hook_event_name
event="$jv"

# Whether THIS event was fired by a subagent rather than by the session's main
# thread. The marker is a top-level `agent_id`, and it is read from the HEAD of
# the payload — everything before `tool_input`, which is where every top-level
# field the harness writes lands.
#
# Reading it from the whole payload is what hid an agent team from this script
# (measured on 2.1.269, 2026-09-12). A teammate launch answers with `agent_id`
# inside tool_response, naming the agent it just spawned, so the main thread's
# own PostToolUse looked like a subagent's tool call and left before
# record_launch could see it. Nothing recorded the teammate, and the Stop that
# followed reported the session done with the team working.
head="${payload%%\"tool_input\":*}"
agent=""
case "$head" in
*'"agent_id":"'*)
    agent="${head#*\"agent_id\":\"}"
    agent="${agent%%\"*}"
    ;;
esac

case "$event" in
UserPromptSubmit)
    # A completing background task re-enters the session as a synthetic prompt
    # carrying its own markup. That retires one id, promptly, before the turn it
    # starts ever reaches Stop.
    #
    # A person typing retires nothing. Until 2026-09-12 it wiped the whole set,
    # because with no expiry on an id, interacting with the session was the only
    # way to unstick one that had gone stale. That crutch cost more than it
    # saved: across the 105 workflow runs recorded on this box, 43 had a human
    # prompt land mid-run, and each one reported the session done with the run
    # still going — the bug Viktor reported ("the status for that session
    # becomes green"). Talking to a session does not end the work it is doing,
    # and bg_sync at the next Stop re-derives the set from the harness's own
    # list, which is what the wipe was standing in for.
    case "$payload" in
    *'"prompt":"<task-notification>'*)
        json_tag task-id
        id_ok "$jv" && bg_del "$jv"
        ;;
    esac
    stamp running
    ;;
PreToolUse)
    # A subagent's own tool calls reach THIS session's hooks carrying agent_id
    # (measured 2026-09-04). Stamping on them made the dot alternate between
    # done and running for as long as a background agent worked, which is why
    # the wrong colour was intermittent rather than constant.
    [ -n "$agent" ] && exit 0
    stamp running
    ;;
PostToolUse)
    [ -n "$agent" ] && exit 0
    record_launch
    stamp running
    ;;
Stop)
    # Stop is the main thread stopping talking, not the end of the turn's work.
    # What the harness lists is the whole answer: the set is rebuilt from it,
    # so a kind no launch could record is picked up here and a finished one is
    # dropped, both without this script having to recognise the launch.
    bg_sync
    bg_read
    if [ -n "$bg" ]; then stamp running; else stamp "done"; fi
    ;;
SessionStart)
    # A fresh claude owes nothing, whatever the option survived from the process
    # that died in this session — but only two of the four sources are a fresh
    # claude. All four confirmed on 2.1.269 (2026-09-12): `startup` and `resume`
    # are a new process, whose predecessor's tasks died with it; `compact` and
    # `clear` are the SAME process carrying on, with its background work
    # untouched, so wiping there reported done over a live run. A long workflow
    # all but guarantees a compaction — the longest real run on this box was
    # 2h22m — and unlike a human prompt it needs nobody to type anything.
    #
    # An absent source reads as a new process, which is what this did before.
    json_field source
    case "$jv" in
    compact | clear) ;;
    *) bg_write "" ;;
    esac
    # Whatever survived decides the state, the same way Stop decides it: keeping
    # the ids and then stamping done would paint the session green anyway.
    bg_read
    if [ -n "$bg" ]; then stamp running; else stamp "done"; fi
    ;;
SubagentStart)
    # A subagent or a teammate has STARTED working. Only a teammate is
    # recorded, and only here, because it is the one kind the Stop registry
    # cannot report: it lists a teammate as running for as long as the
    # teammate exists, idle or not (see bg_sync).
    #
    # The two are told apart by the id the harness builds for each, measured
    # on 2.1.269, 2026-09-12:
    #
    #   a plain subagent   agent_id a8574b6e73ce517a0,      agent_type general-purpose
    #   a teammate         agent_id aprobe2-9b0fe9e64c9f7bdf, agent_type probe2
    #
    # so a teammate's id is `a` + its own name + `-` + a hash, and a plain
    # subagent's is not. The plain one is left to the registry, which retires
    # it honestly.
    #
    # This fires on every activation, not just the spawn: a teammate woken by
    # SendMessage, or by a person typing into its pane, starts again here.
    # Watching the Agent tool's own PostToolUse would have caught neither, and
    # the first of those is how most of a team's work actually arrives.
    id_ok "$agent" || exit 0
    json_field agent_type
    id_ok "$jv" || exit 0
    case "$agent" in
    "a$jv-"*)
        bg_add "t:$jv"
        stamp running
        ;;
    esac
    ;;
TeammateIdle)
    # The teammate stopped working, and this is the only event that says so.
    # The registry still calls it running, and its answer reaches the lead
    # over the team's own channel rather than as a prompt, so no
    # UserPromptSubmit fires either — measured 2026-09-12, a teammate that
    # finished between turns produced no prompt hook at all.
    #
    # Retire the name and stamp nothing. The lead is usually mid-turn when a
    # teammate reports, since the report is what wakes it, and stamping done
    # here would paint a working session green until its next tool call. The
    # turn boundary that follows settles the state the way it always does.
    json_field teammate_name
    id_ok "$jv" && bg_del "$jv"
    ;;
Notification)
    handle_notify
    ;;
"")
    # No hook_event_name: a harness older than this script, or an event fired
    # by something else. Fall back to the argv word alone, which is what this
    # script did before background work was tracked.
    case "$mode" in
    running | done) stamp "$mode" ;;
    awaiting) stamp awaiting ;;
    notify) handle_notify ;;
    esac
    ;;
*)
    # A wired event this script has no rule for. Honour the argv word so a
    # future infra change cannot silently stop the indicator working.
    case "$mode" in
    running | done) stamp "$mode" ;;
    awaiting) stamp awaiting ;;
    notify) handle_notify ;;
    esac
    ;;
esac

exit 0
