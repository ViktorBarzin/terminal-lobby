[Unit]
Description=ttyd Terminal Service (multi-session lobby + per-Authentik-user attach on port 7681)
After=network.target

[Service]
# Every service reads the same configuration: the identity header name, the
# optional proxy secret, the single/multi-user mode and the bind address.
# '-' means an absent file is not an error, so a box that predates the package
# still starts on the compiled-in defaults.
#
# Two files, in order: the package's, then local overrides. The second wins on
# any key it sets. Local settings belong there, not in the first, so a package
# upgrade never prompts about a conffile you edited.
EnvironmentFile=-/etc/terminal-lobby.conf
EnvironmentFile=-/etc/terminal-lobby.local.conf
# Fallback for a box with no config file yet: Environment= is applied
# BEFORE EnvironmentFile, so the file wins wherever it sets the same key.
Environment=TL_AUTH_HEADER=X-Forwarded-User
# Truecolor hint for the spawned tmux client (Task 1.14). INERT on the
# current tmux 3.4 — upstream only added "Set and check COLORTERM as a
# hint for RGB colour" in tmux 3.6 — so /etc/tmux.conf (terminal-features
# 'xterm*:RGB', shipped by deploy.sh) is the operative fix today. Kept so
# a future OS tmux upgrade gets the hint automatically. Cross-user
# attaches also lose this to sudo's env_reset; the system tmux.conf
# covers those users regardless.
Environment=COLORTERM=truecolor
# -P 30: WebSocket ping every 30s instead of ttyd's 5s default. Each ping
# wakes a backgrounded phone's radio, so 5s drained battery for nothing;
# 30s cuts that 6x and stays well under the Traefik idle timeout (180s) and
# Cloudflare's ~100s WS idle, so an idle terminal never churns reconnects.
# The frontend also drops the socket entirely after the tab is hidden 60s
# (see frontend/index.html battery saver) — this covers foreground-idle.
ExecStart=/usr/local/bin/ttyd -W -a -H ${TL_AUTH_HEADER} -P 30 -t enableClipboard=true -I /usr/local/share/ttyd/index.html -p 7681 /usr/local/bin/tmux-attach.sh
Restart=always
User=wizard

[Install]
WantedBy=multi-user.target
