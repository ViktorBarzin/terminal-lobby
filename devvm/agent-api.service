[Unit]
Description=agent-api (terminal-lobby machine-facing API)
After=network.target
# Never stop trying to start. 8710 is outside the block this package owns --
# the other seven services sit at 7681 and 7683-7689 -- and on a shared box the
# 8xxx range is where people put an ad-hoc listener for an hour. agent-api ends
# the process when a listener it opened fails, so a taken port exits it, and
# with systemd's default limit of five starts in ten seconds the unit would be
# failed and staying failed within a few seconds of the install, long after
# whatever held the port had gone. A taken port is a condition that passes;
# this outlasts it and comes up on its own when it does.
StartLimitIntervalSec=0

[Service]
# Every service reads the same configuration: the identity header name, the
# optional proxy secret, the single/multi-user mode and the bind address.
# '-' means an absent file is not an error, so a box that predates the package
# still starts on the compiled-in defaults.
#
# Two files, in order: the package's, then local overrides. The second wins on
# any key it sets. Local settings belong there, not in the first, so a package
# upgrade never prompts about a conffile you edited.
#
# This unit reads one key from them that the browser-facing five do not:
# TL_BEARER_TOKENS, the per-caller credentials file. Nothing under /v1 answers
# without a line in it, so a box that has never been given one runs this
# service and serves nobody, which is the right default for a port whose
# callers are programs.
EnvironmentFile=-/etc/terminal-lobby.conf
EnvironmentFile=-/etc/terminal-lobby.local.conf
# Binds 127.0.0.1:8710 always, and TL_AGENT_BIND names any further address to
# bind ALONGSIDE it, comma-separated. Loopback stays because tl-apply verifies
# the install by probing 127.0.0.1:8710. A value naming every interface
# (0.0.0.0, ::, a bare :port), or a host this box cannot resolve, stops the
# service at startup rather than being narrowed or widened for it.
#
# It does NOT read the box-wide TL_BIND the other five services take: their proxy
# is the cluster ingress on another host, so TL_BIND is 0.0.0.0 on this box and
# inheriting it would put a port that starts Claude sessions on the LAN as soon
# as the package installed. This one is reached over the tailnet instead, so
# the address that belongs here is this host's tailnet address, which the
# Headscale ACL opens to tag:muse alone. Left unset, the service is reachable
# from this host only, and says so at startup.
#
# Unlike its siblings it is not behind the K8s ingress and takes no identity
# header at all: the caller is a program presenting a bearer credential, and
# the auth wrapper strips TL_AUTH_HEADER and X-TL-Proxy-Secret from every
# request before the identity gate reads it, so the browser path cannot answer
# here whatever this box is configured with.
ExecStart=/usr/local/bin/agent-api
User=wizard
Restart=always
# With the start limit off, systemd's 100ms default would retry a bind that
# cannot succeed ten times a second for as long as the port stays taken.
RestartSec=5
# Runs as wizard, sibling to clipboard-upload (:7683), tmux-api (:7684),
# session-events (:7685), file-api (:7686) and skills-api (:7688). It reaches
# tmux through sessionio in-process, over the same `sudo -u <user> tmux` grant
# they use (devvm/sudoers.d-ttyd-users), and calls none of their ports — so it
# needs no grant of its own, and no sandboxing directive that would take sudo
# away. NoNewPrivileges here would break every session it touches.

# /var/log/agent-api, created by systemd and owned by User= before ExecStart
# runs. The service account cannot create a directory under /var/log itself,
# and without this the trace disables itself at startup while the service goes
# on serving — unrecorded, which is the one thing the design says it must not
# be.
#
# 0700, and this line decides it whatever else sets the directory: systemd
# re-applies LogsDirectoryMode on EVERY start, to a directory that already
# exists as well as one it creates. Measured on systemd 255 here, 2026-09-16:
# a pre-created 0700 directory read 0750 after a single start. infra's
# playbooks/devvm.yml creates this same directory at 0700, for the reason that
# settles the value — a trace line carries the caller's request verbatim, and
# ancamilea, emo and breakglass all have shells on this box — so anything wider
# here would quietly override the playbook and then show up in its next
# --check run as drift that never clears. promtail, which tails the file into
# Loki, runs as root and needs no group bit.
LogsDirectory=agent-api
LogsDirectoryMode=0700

[Install]
WantedBy=multi-user.target
