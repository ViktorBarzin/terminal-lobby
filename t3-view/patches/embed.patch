new file mode 100644
index 0000000..8649850
--- /dev/null
+++ b/apps/web/src/embed.tsx
@@ -0,0 +1,328 @@
+// terminal-lobby embed patch (t3-view/EMBED.md). This build only ships with
+// the tl-t3-view sidecar, so lobby-server mode is always on: index.css hides,
+// under html[data-t3-lobby], the controls whose RPCs the sidecar refuses.
+// Framed with ?embed, the lobby also draws the chrome: index.css hides T3's
+// header under html[data-t3-embed], AppSidebarLayout drops the sidebar, and
+// chords the lobby names in tl-bindings go to it, since keys typed in a
+// cross-origin frame never reach the parent.
+import { parseScopedThreadKey, scopedThreadKey } from "@t3tools/client-runtime/environment";
+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { useNavigate, useParams } from "@tanstack/react-router";
+import { useEffect, useMemo } from "react";
+
+import { stackedThreadToast, toastManager } from "./components/ui/toast";
+import { resolveComposerDraftKey, useComposerDraftStore } from "./composerDraftStore";
+import {
+  draftModesToClear,
+  embedFlag,
+  embedHost,
+  findRouteSession,
+  isTextEntry,
+  keyMessage,
+  modelPickKey,
+  modelPickToApply,
+  parentOrigin,
+  parseLobbyMessage,
+  readyMessage,
+  routeFrameKey,
+  routeMessage,
+  sessionFromLookup,
+  sessionLookupPath,
+  threadFromLookup,
+  threadLookupPath,
+  withPlanModeDefault,
+  withoutModelPick,
+  type FrameChord,
+  type FrameMessage,
+  type RouteSession,
+  type ThreadModes,
+} from "./embed.logic";
+import { useThreadShell } from "./state/entities";
+import { usePrimaryEnvironmentId } from "./state/environments";
+import { threadEnvironment } from "./state/threads";
+import { useOrchestrationCommand } from "./state/use-orchestration-command";
+import { resolveThreadRouteRef } from "./threadRoutes";
+
+const FLAG_KEY = "t3-embed";
+const CLIENT_SETTINGS_KEY = "t3code:client-settings:v1";
+
+// The flag is kept for the frame's session, since T3's own navigation drops
+// the query; the parent's origin is read from the browser every time.
+function detectHost(): string | null {
+  if (window.parent === window) return null;
+  let remembered = false;
+  try {
+    remembered = window.sessionStorage.getItem(FLAG_KEY) === "1";
+  } catch {
+    remembered = false;
+  }
+  const flag = embedFlag(window.location.search, remembered);
+  const host = embedHost(
+    flag,
+    parentOrigin(window.location.ancestorOrigins, document.referrer),
+    window.location,
+  );
+  if (host !== null && !remembered) {
+    try {
+      window.sessionStorage.setItem(FLAG_KEY, "1");
+    } catch {
+      // Without storage the flag lasts until T3's first navigation.
+    }
+  }
+  return host;
+}
+
+// Lobby-server mode, full page and embedded alike (a build-time constant).
+document.documentElement.dataset.t3Lobby = "";
+
+const host = detectHost();
+export const isEmbedded = host !== null;
+
+let chords: readonly FrameChord[] | null = null;
+let readySent = false;
+let pendingOpen: string | null = null;
+let openThread: ((threadId: string) => void) | null = null;
+// The route last told to the lobby (tl-ready's or a tl-route's), and a count
+// that drops a lookup the next route change overtook.
+let reportedThread: string | null | undefined;
+let routeAsk = 0;
+
+function post(message: FrameMessage) {
+  if (host !== null) window.parent.postMessage(message, host);
+}
+
+function editing(event: KeyboardEvent): boolean {
+  let element = event.target instanceof Element ? event.target : null;
+  while (element?.shadowRoot?.activeElement) element = element.shadowRoot.activeElement;
+  return isTextEntry(element instanceof HTMLElement ? element : null);
+}
+
+// The lobby's thread key, as the sidecar names that thread.
+// Which of the user's lobby sessions a thread is; null for none.
+async function lookupSession(threadId: string): Promise<RouteSession | null> {
+  try {
+    const response = await fetch(sessionLookupPath(threadId), { credentials: "same-origin" });
+    return response.ok ? sessionFromLookup(await response.json()) : null;
+  } catch {
+    return null;
+  }
+}
+
+async function resolveThread(key: string): Promise<string> {
+  try {
+    const response = await fetch(threadLookupPath(key), { credentials: "same-origin" });
+    if (!response.ok) return key;
+    return threadFromLookup(await response.json()) ?? key;
+  } catch {
+    return key;
+  }
+}
+
+if (host !== null) {
+  document.documentElement.dataset.t3Embed = "";
+  try {
+    const settings = withPlanModeDefault(window.localStorage.getItem(CLIENT_SETTINGS_KEY));
+    if (settings !== null) window.localStorage.setItem(CLIENT_SETTINGS_KEY, settings);
+  } catch {
+    // Without storage the toggle stays hidden; plan mode still shows from the lobby.
+  }
+  // Capture on window, registered at startup, so it runs before T3's own.
+  window.addEventListener(
+    "keydown",
+    (event) => {
+      if (event.isComposing || routeFrameKey(event, chords, editing(event)) !== "claim") return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      post(keyMessage(event));
+    },
+    true,
+  );
+  window.addEventListener("keydown", (event) => {
+    if (event.defaultPrevented || event.isComposing) return;
+    if (routeFrameKey(event, chords, editing(event)) === "passive") post(keyMessage(event));
+  });
+  window.addEventListener("message", (event) => {
+    if (event.source !== window.parent || event.origin !== host) return;
+    const message = parseLobbyMessage(event.data);
+    if (message?.type === "tl-bindings") {
+      chords = message.chords;
+    } else if (message?.type === "tl-open") {
+      if (openThread === null) pendingOpen = message.threadId;
+      else openThread(message.threadId);
+    }
+  });
+}
+
+// The server thread's modes last seen on this page, by scoped thread key.
+const seenModes = new Map<string, ThreadModes>();
+
+// The thread the frame shows: its scoped key, its ref and its shell.
+function useRoutedThread() {
+  const routeKey = useParams({
+    strict: false,
+    select: (params) => {
+      const ref = resolveThreadRouteRef(params);
+      return ref === null ? null : scopedThreadKey(ref);
+    },
+  });
+  const threadRef = useMemo(
+    () => (routeKey === null ? null : parseScopedThreadKey(routeKey)),
+    [routeKey],
+  );
+  const shell = useThreadShell(threadRef);
+  return { routeKey, threadRef, shell };
+}
+
+// The composer draft's Plan/Build and runtime picks follow the server thread:
+// a mode the server leaves (a plan approved from its card, a mode changed in
+// the lobby) is cleared from the draft, so the next send does not restore it.
+function useDraftFollowsServerModes() {
+  const { routeKey, threadRef, shell } = useRoutedThread();
+  const interactionMode = shell?.interactionMode;
+  const runtimeMode = shell?.runtimeMode;
+
+  useEffect(() => {
+    if (routeKey === null || threadRef === null) return;
+    if (interactionMode === undefined || runtimeMode === undefined) return;
+    const server = { interactionMode, runtimeMode };
+    const clear = draftModesToClear(seenModes.get(routeKey), server);
+    seenModes.set(routeKey, server);
+    const drafts = useComposerDraftStore.getState();
+    if (clear.interactionMode) drafts.setInteractionMode(threadRef, null);
+    if (clear.runtimeMode) drafts.setRuntimeMode(threadRef, null);
+  }, [routeKey, threadRef, interactionMode, runtimeMode]);
+}
+
+// The pick sent for each thread, by scoped key, while the lobby works on it,
+// so a re-render does not send it twice.
+const sentPicks = new Map<string, string>();
+
+function draftOf(threadRef: ScopedThreadRef) {
+  const state = useComposerDraftStore.getState();
+  const key = resolveComposerDraftKey(state, threadRef);
+  return key === null ? null : (state.draftsByThreadKey[key] ?? null);
+}
+
+function forgetModelPick(threadRef: ScopedThreadRef, instanceId: string) {
+  useComposerDraftStore.setState((state) => {
+    const key = resolveComposerDraftKey(state, threadRef);
+    const draft = key === null ? undefined : state.draftsByThreadKey[key];
+    if (key === null || draft === undefined) return state;
+    return {
+      draftsByThreadKey: { ...state.draftsByThreadKey, [key]: withoutModelPick(draft, instanceId) },
+    };
+  });
+}
+
+// A model or effort picked in the composer goes to the session at once, as
+// the lobby's Text view does, rather than riding on the next send (see
+// modelPickToApply). Either way the draft lets go of the pick afterwards, so
+// the composer shows the session's model: the new one, or the old one with a
+// toast giving the lobby's reason when it refused.
+function useModelPickApplies() {
+  const { routeKey, threadRef, shell } = useRoutedThread();
+  const draft = useComposerDraftStore((state) => {
+    if (threadRef === null) return null;
+    const key = resolveComposerDraftKey(state, threadRef);
+    return key === null ? null : (state.draftsByThreadKey[key] ?? null);
+  });
+  const serverSelection = shell?.modelSelection;
+  const updateMetadata = useOrchestrationCommand(threadEnvironment.updateMetadata, {
+    reportFailure: false,
+  });
+
+  useEffect(() => {
+    if (routeKey === null || threadRef === null || draft === null) return;
+    const instanceId = draft.activeProvider;
+    const pick = instanceId === null ? undefined : draft.modelSelectionByProvider[instanceId];
+    if (instanceId === null || pick === undefined) return;
+    const explicit = draft.modelSelectionExplicit === true;
+    if (modelPickToApply(pick, explicit, serverSelection) === null) return;
+    const key = modelPickKey(pick);
+    if (sentPicks.get(routeKey) === key) return;
+    sentPicks.set(routeKey, key);
+    void updateMetadata({
+      environmentId: threadRef.environmentId,
+      input: { threadId: threadRef.threadId, modelSelection: pick },
+    }).then((result) => {
+      if (sentPicks.get(routeKey) === key) sentPicks.delete(routeKey);
+      if (result._tag === "Failure" && isAtomCommandInterrupted(result)) return;
+      // A newer pick made while this one was in flight stays in the draft.
+      const now = draftOf(threadRef)?.modelSelectionByProvider[instanceId];
+      if (now !== undefined && modelPickKey(now) === key) forgetModelPick(threadRef, instanceId);
+      if (result._tag !== "Failure") return;
+      const error = squashAtomCommandFailure(result);
+      toastManager.add(
+        stackedThreadToast({
+          type: "error",
+          title: "Model not changed",
+          description: error instanceof Error ? error.message : "The session did not take it.",
+        }),
+      );
+    });
+  }, [routeKey, threadRef, draft, serverSelection, updateMetadata]);
+}
+
+/** Announces the environment to the lobby and follows its tl-open. */
+export function EmbedBridge() {
+  useDraftFollowsServerModes();
+  useModelPickApplies();
+  const navigate = useNavigate();
+  const environmentId = usePrimaryEnvironmentId();
+  const threadId = useParams({
+    strict: false,
+    select: (params) => resolveThreadRouteRef(params)?.threadId ?? null,
+  });
+
+  useEffect(() => {
+    if (environmentId === null || readySent) return;
+    readySent = true;
+    reportedThread = threadId;
+    post(readyMessage(environmentId, threadId));
+  }, [environmentId, threadId]);
+
+  // T3's own navigation (its palette, New thread) moved the frame: tell the
+  // lobby, whose header and chords follow the session it framed.
+  useEffect(() => {
+    if (!readySent || threadId === reportedThread) return;
+    reportedThread = threadId;
+    const ask = ++routeAsk;
+    if (threadId === null) {
+      post(routeMessage(null, null));
+      return;
+    }
+    void findRouteSession(
+      () => lookupSession(threadId),
+      (ms) => new Promise((resolve) => setTimeout(resolve, ms)),
+      () => ask === routeAsk,
+    ).then(({ settled, session }) => {
+      if (settled) post(routeMessage(threadId, session));
+    });
+  }, [environmentId, threadId]);
+
+  useEffect(() => {
+    if (environmentId === null) return;
+    // An href rather than typed search params: the thread route declares
+    // none, and the contract keeps ?embed on the URL.
+    openThread = (target) => {
+      void resolveThread(target).then((resolved) => {
+        const path = `/${encodeURIComponent(environmentId)}/${encodeURIComponent(resolved)}`;
+        if (window.location.pathname !== path) void navigate({ href: `${path}?embed` });
+      });
+    };
+    if (pendingOpen !== null) {
+      const target = pendingOpen;
+      pendingOpen = null;
+      openThread(target);
+    }
+    return () => {
+      openThread = null;
+    };
+  }, [environmentId, navigate]);
+
+  return null;
+}
