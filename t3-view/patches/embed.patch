index 0000000..633000b
--- /dev/null
+++ b/apps/web/src/embed.logic.ts
@@ -0,0 +1,265 @@
+// terminal-lobby embed patch, the pure half. The contract is terminal-lobby's
+// t3-view/EMBED.md (version 1); embed.tsx wires this to the DOM and router.
+
+export interface FrameChord {
+  readonly ctrl: boolean;
+  readonly shift: boolean;
+  readonly alt: boolean;
+  readonly meta: boolean;
+  readonly key: string;
+  readonly code?: string;
+  readonly notWhileEditing?: true;
+  readonly passive?: true;
+}
+
+export interface KeyLike {
+  readonly key: string;
+  readonly code: string;
+  readonly ctrlKey: boolean;
+  readonly metaKey: boolean;
+  readonly shiftKey: boolean;
+  readonly altKey: boolean;
+  readonly repeat: boolean;
+}
+
+export type LobbyMessage =
+  | { readonly type: "tl-bindings"; readonly v: 1; readonly chords: readonly FrameChord[] }
+  | { readonly type: "tl-open"; readonly v: 1; readonly threadId: string };
+
+/** The lobby session a thread is, as the lobby keys it (the sidecar's answer). */
+export interface RouteSession {
+  readonly key: string;
+  readonly name: string;
+}
+
+export type FrameMessage =
+  | { type: "tl-ready"; v: 1; environmentId: string; threadId: string | null }
+  | ({ type: "tl-key"; v: 1 } & KeyLike)
+  | { type: "tl-route"; v: 1; threadId: string | null; session: RouteSession | null };
+
+const LOOPBACK = new Set(["localhost", "127.0.0.1", "[::1]"]);
+
+/**
+ * The framing page's origin as the browser reports it, so the page cannot
+ * choose it: ancestorOrigins where the browser has it (Chrome, Safari), else
+ * the referrer's origin (Firefox). Null when neither names one.
+ */
+export function parentOrigin(
+  ancestorOrigins: ArrayLike<string> | undefined,
+  referrer: string,
+): string | null {
+  const first = ancestorOrigins !== undefined && ancestorOrigins.length > 0 ? ancestorOrigins[0] : undefined;
+  if (first !== undefined) return first === "null" ? null : first;
+  try {
+    const origin = new URL(referrer).origin;
+    return origin === "null" ? null : origin;
+  } catch {
+    return null;
+  }
+}
+
+/** The bare ?embed flag, or the one remembered for this frame's session. */
+export function embedFlag(search: string, remembered: boolean): boolean {
+  return remembered || new URLSearchParams(search).has("embed");
+}
+
+/** The lobby's host name, beside the frame's own (t3view.example.org -> terminal.example.org). */
+const LOBBY_LABEL = "terminal";
+
+/**
+ * The lobby origin the frame may talk to, or null to run as upstream: the
+ * parent's origin when the flag is on and the parent is exactly
+ * https://terminal.<the frame's domain>, or http on loopback with the frame on
+ * loopback too. Only the lobby itself, never a sibling page on the same site:
+ * the parent this accepts can read every key the frame forwards.
+ */
+export function embedHost(
+  flag: boolean,
+  parent: string | null,
+  frame: { readonly hostname: string },
+): string | null {
+  if (!flag || parent === null) return null;
+  let url: URL;
+  try {
+    url = new URL(parent);
+  } catch {
+    return null;
+  }
+  if (url.origin !== parent.replace(/\/$/, "")) return null;
+  if (url.protocol === "https:") {
+    const domain = frame.hostname.toLowerCase().split(".").slice(1).join(".");
+    if (!domain.includes(".")) return null;
+    return url.origin === `https://${LOBBY_LABEL}.${domain}` ? url.origin : null;
+  }
+  if (url.protocol === "http:" && LOOPBACK.has(frame.hostname) && LOOPBACK.has(url.hostname)) {
+    return url.origin;
+  }
+  return null;
+}
+
+/** A text field owns the keys a `notWhileEditing` chord would take. */
+export function isTextEntry(
+  element: { readonly tagName: string; readonly type?: string; readonly isContentEditable?: boolean } | null,
+): boolean {
+  if (element === null) return false;
+  if (element.isContentEditable === true) return true;
+  switch (element.tagName.toUpperCase()) {
+    case "TEXTAREA":
+    case "SELECT":
+      return true;
+    case "INPUT":
+      return !["button", "checkbox", "radio"].includes((element.type ?? "text").toLowerCase());
+    default:
+      return false;
+  }
+}
+
+function matches(e: KeyLike, c: FrameChord): boolean {
+  if (e.ctrlKey !== c.ctrl || e.shiftKey !== c.shift || e.altKey !== c.alt || e.metaKey !== c.meta) {
+    return false;
+  }
+  const key = e.key.toLowerCase();
+  return (key === "esc" ? "escape" : key) === c.key || (c.code !== undefined && e.code === c.code);
+}
+
+/** claim: take it from T3 and forward it. passive: forward only if T3 left it. */
+export function routeFrameKey(
+  e: KeyLike,
+  chords: readonly FrameChord[] | null,
+  editing: boolean,
+): "claim" | "passive" | "ignore" {
+  let passive = false;
+  for (const c of chords ?? []) {
+    if (!matches(e, c)) continue;
+    if (c.passive) passive = true;
+    else if (!(c.notWhileEditing && editing)) return "claim";
+  }
+  return passive ? "passive" : "ignore";
+}
+
+export function keyMessage(e: KeyLike): FrameMessage {
+  return {
+    type: "tl-key",
+    v: 1,
+    key: e.key,
+    code: e.code,
+    ctrlKey: e.ctrlKey,
+    metaKey: e.metaKey,
+    shiftKey: e.shiftKey,
+    altKey: e.altKey,
+    repeat: e.repeat,
+  };
+}
+
+export function readyMessage(environmentId: string, threadId: string | null): FrameMessage {
+  return { type: "tl-ready", v: 1, environmentId, threadId };
+}
+
+/** The frame moved on its own: the thread it is on now, and which lobby session that is. */
+export function routeMessage(threadId: string | null, session: RouteSession | null): FrameMessage {
+  return { type: "tl-route", v: 1, threadId, session };
+}
+
+const isRecord = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+function parseChord(v: unknown): FrameChord | null {
+  if (!isRecord(v)) return null;
+  const { ctrl, shift, alt, meta, key, code, notWhileEditing, passive } = v;
+  if (
+    typeof ctrl !== "boolean" ||
+    typeof shift !== "boolean" ||
+    typeof alt !== "boolean" ||
+    typeof meta !== "boolean" ||
+    typeof key !== "string" ||
+    key === "" ||
+    key.length > 32 ||
+    (code !== undefined && (typeof code !== "string" || code.length > 32)) ||
+    (notWhileEditing !== undefined && notWhileEditing !== true) ||
+    (passive !== undefined && passive !== true)
+  ) {
+    return null;
+  }
+  return {
+    ctrl,
+    shift,
+    alt,
+    meta,
+    key,
+    ...(typeof code === "string" ? { code } : {}),
+    ...(notWhileEditing === true ? { notWhileEditing } : {}),
+    ...(passive === true ? { passive } : {}),
+  };
+}
+
+/**
+ * A chord the frame will hand over: one with Ctrl, Alt or Meta, or Escape.
+ * The lobby asks for nothing else, and a bare or Shift-only key would forward
+ * ordinary typing.
+ */
+function isForwardable(c: FrameChord): boolean {
+  return c.ctrl || c.alt || c.meta || c.key === "escape";
+}
+
+/** A message from the lobby, or null for anything outside the contract. */
+export function parseLobbyMessage(data: unknown): LobbyMessage | null {
+  if (!isRecord(data) || data.v !== 1) return null;
+  if (data.type === "tl-bindings") {
+    if (!Array.isArray(data.chords) || data.chords.length > 256) return null;
+    const chords = data.chords.map(parseChord);
+    if (chords.some((c) => c === null)) return null;
+    return {
+      type: "tl-bindings",
+      v: 1,
+      chords: chords.filter((c): c is FrameChord => c !== null && isForwardable(c)),
+    };
+  }
+  if (data.type === "tl-open") {
+    const { threadId } = data;
+    if (typeof threadId !== "string" || threadId === "" || threadId.length > 256) return null;
+    return { type: "tl-open", v: 1, threadId };
+  }
+  return null;
+}
+
+/**
+ * The client's stored settings with plan mode on, or null to leave them: the
+ * lobby's sessions take plan mode, but T3 hides its toggle until a Settings
+ * switch is on, and the embed has no Settings page. A choice already made
+ * stays.
+ */
+export function withPlanModeDefault(raw: string | null): string | null {
+  if (raw === null) return JSON.stringify({ planModeEnabled: true });
+  let value: unknown;
+  try {
+    value = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  if (typeof value !== "object" || value === null || Array.isArray(value)) return null;
+  if ("planModeEnabled" in value) return null;
+  return JSON.stringify({ ...value, planModeEnabled: true });
+}
+
+/** Where the sidecar answers which thread a lobby key names (a session T3 created keeps T3's id). */
+export function threadLookupPath(key: string): string {
+  return `/.well-known/t3/thread/${encodeURIComponent(key)}`;
+}
+
+export function threadFromLookup(body: unknown): string | null {
+  if (typeof body !== "object" || body === null) return null;
+  const threadId: unknown = (body as { threadId?: unknown }).threadId;
+  return typeof threadId === "string" && threadId !== "" ? threadId : null;
+}
+
+/** Where the sidecar answers which lobby session a thread is (404 for none of the user's). */
+export function sessionLookupPath(threadId: string): string {
+  return `/.well-known/t3/session/${encodeURIComponent(threadId)}`;
+}
+
+export function sessionFromLookup(body: unknown): RouteSession | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { key, name } = body as { key?: unknown; name?: unknown };
+  const ok = (v: unknown): v is string => typeof v === "string" && v !== "" && v.length <= 256;
+  return ok(key) && ok(name) ? { key, name } : null;
+}
diff --git a/apps/web/src/embed.tsx b/apps/web/src/embed.tsx
new file mode 100644
index 0000000..c17ee0d
--- /dev/null
+++ b/apps/web/src/embed.tsx
@@ -0,0 +1,190 @@
+// terminal-lobby embed patch (t3-view/EMBED.md). Framed with ?embed,
+// the lobby draws the chrome: index.css hides T3's header and panels under
+// html[data-t3-embed], AppSidebarLayout drops the sidebar, and chords the
+// lobby names in tl-bindings go to it, since keys typed in a cross-origin
+// frame never reach the parent.
+import { useNavigate, useParams } from "@tanstack/react-router";
+import { useEffect } from "react";
+
+import {
+  embedFlag,
+  embedHost,
+  isTextEntry,
+  keyMessage,
+  parentOrigin,
+  parseLobbyMessage,
+  readyMessage,
+  routeFrameKey,
+  routeMessage,
+  sessionFromLookup,
+  sessionLookupPath,
+  threadFromLookup,
+  threadLookupPath,
+  withPlanModeDefault,
+  type FrameChord,
+  type FrameMessage,
+  type RouteSession,
+} from "./embed.logic";
+import { usePrimaryEnvironmentId } from "./state/environments";
+import { resolveThreadRouteRef } from "./threadRoutes";
+
+const FLAG_KEY = "t3-embed";
+const CLIENT_SETTINGS_KEY = "t3code:client-settings:v1";
+
+// The flag is kept for the frame's session, since T3's own navigation drops
+// the query; the parent's origin is read from the browser every time.
+function detectHost(): string | null {
+  if (window.parent === window) return null;
+  let remembered = false;
+  try {
+    remembered = window.sessionStorage.getItem(FLAG_KEY) === "1";
+  } catch {
+    remembered = false;
+  }
+  const flag = embedFlag(window.location.search, remembered);
+  const host = embedHost(
+    flag,
+    parentOrigin(window.location.ancestorOrigins, document.referrer),
+    window.location,
+  );
+  if (host !== null && !remembered) {
+    try {
+      window.sessionStorage.setItem(FLAG_KEY, "1");
+    } catch {
+      // Without storage the flag lasts until T3's first navigation.
+    }
+  }
+  return host;
+}
+
+const host = detectHost();
+export const isEmbedded = host !== null;
+
+let chords: readonly FrameChord[] | null = null;
+let readySent = false;
+let pendingOpen: string | null = null;
+let openThread: ((threadId: string) => void) | null = null;
+// The route last told to the lobby (tl-ready's or a tl-route's), and a count
+// that drops a lookup the next route change overtook.
+let reportedThread: string | null | undefined;
+let routeAsk = 0;
+
+function post(message: FrameMessage) {
+  if (host !== null) window.parent.postMessage(message, host);
+}
+
+function editing(event: KeyboardEvent): boolean {
+  let element = event.target instanceof Element ? event.target : null;
+  while (element?.shadowRoot?.activeElement) element = element.shadowRoot.activeElement;
+  return isTextEntry(element instanceof HTMLElement ? element : null);
+}
+
+// The lobby's thread key, as the sidecar names that thread.
+// Which of the user's lobby sessions a thread is; null for none.
+async function lookupSession(threadId: string): Promise<RouteSession | null> {
+  try {
+    const response = await fetch(sessionLookupPath(threadId), { credentials: "same-origin" });
+    return response.ok ? sessionFromLookup(await response.json()) : null;
+  } catch {
+    return null;
+  }
+}
+
+async function resolveThread(key: string): Promise<string> {
+  try {
+    const response = await fetch(threadLookupPath(key), { credentials: "same-origin" });
+    if (!response.ok) return key;
+    return threadFromLookup(await response.json()) ?? key;
+  } catch {
+    return key;
+  }
+}
+
+if (host !== null) {
+  document.documentElement.dataset.t3Embed = "";
+  try {
+    const settings = withPlanModeDefault(window.localStorage.getItem(CLIENT_SETTINGS_KEY));
+    if (settings !== null) window.localStorage.setItem(CLIENT_SETTINGS_KEY, settings);
+  } catch {
+    // Without storage the toggle stays hidden; plan mode still shows from the lobby.
+  }
+  // Capture on window, registered at startup, so it runs before T3's own.
+  window.addEventListener(
+    "keydown",
+    (event) => {
+      if (event.isComposing || routeFrameKey(event, chords, editing(event)) !== "claim") return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      post(keyMessage(event));
+    },
+    true,
+  );
+  window.addEventListener("keydown", (event) => {
+    if (event.defaultPrevented || event.isComposing) return;
+    if (routeFrameKey(event, chords, editing(event)) === "passive") post(keyMessage(event));
+  });
+  window.addEventListener("message", (event) => {
+    if (event.source !== window.parent || event.origin !== host) return;
+    const message = parseLobbyMessage(event.data);
+    if (message?.type === "tl-bindings") {
+      chords = message.chords;
+    } else if (message?.type === "tl-open") {
+      if (openThread === null) pendingOpen = message.threadId;
+      else openThread(message.threadId);
+    }
+  });
+}
+
+/** Announces the environment to the lobby and follows its tl-open. */
+export function EmbedBridge() {
+  const navigate = useNavigate();
+  const environmentId = usePrimaryEnvironmentId();
+  const threadId = useParams({
+    strict: false,
+    select: (params) => resolveThreadRouteRef(params)?.threadId ?? null,
+  });
+
+  useEffect(() => {
+    if (environmentId === null || readySent) return;
+    readySent = true;
+    reportedThread = threadId;
+    post(readyMessage(environmentId, threadId));
+  }, [environmentId, threadId]);
+
+  // T3's own navigation (its palette, New thread) moved the frame: tell the
+  // lobby, whose header and chords follow the session it framed.
+  useEffect(() => {
+    if (!readySent || threadId === reportedThread) return;
+    reportedThread = threadId;
+    const ask = ++routeAsk;
+    if (threadId === null) {
+      post(routeMessage(null, null));
+      return;
+    }
+    void lookupSession(threadId).then((session) => {
+      if (ask === routeAsk) post(routeMessage(threadId, session));
+    });
+  }, [environmentId, threadId]);
+
+  useEffect(() => {
+    if (environmentId === null) return;
+    // An href rather than typed search params: the thread route declares
+    // none, and the contract keeps ?embed on the URL.
+    openThread = (target) => {
+      void resolveThread(target).then((resolved) => {
+        const path = `/${encodeURIComponent(environmentId)}/${encodeURIComponent(resolved)}`;
+        if (window.location.pathname !== path) void navigate({ href: `${path}?embed` });
+      });
+    };
+    if (pendingOpen !== null) {
+      const target = pendingOpen;
+      pendingOpen = null;
+      openThread(target);
+    }
+    return () => {
+      openThread = null;
+    };
+  }, [environmentId, navigate]);
+
+  return null;
+}
