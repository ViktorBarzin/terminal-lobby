+/* terminal-lobby embed patch (embed.tsx). Lobby-server mode: this build only
+   ever runs against tl-t3-view, which refuses the RPCs behind these controls,
+   so they are hidden on the full page and in the frame alike. */
+/* Titlebar toggles for the terminal drawer, the right panel (diffs, files,
+   preview, pull requests) and the thread details panel. */
+html[data-t3-lobby] [data-workspace-titlebar-controls],
+/* Thread details: environment and branch pickers, open-in-editor, project
+   scripts, commit/push/PR actions and scheduled automations. */
+html[data-t3-lobby] [data-thread-details-panel],
+/* The terminal drawer itself, should a shortcut open it: terminal.* is unserved. */
+html[data-t3-lobby] [data-thread-terminal-drawer],
+/* Sidebar links to pages built on unserved RPCs (pullRequests.*, server.getUsageSummary). */
+html[data-t3-lobby] [data-sidebar-utility="Pull Requests"],
+html[data-t3-lobby] [data-sidebar-utility="Usage"],
+/* Settings sections whose reads and writes the sidecar refuses: provider
+   setup and installs, server keybindings, device hosts and preview,
+   scheduled tasks, source control accounts, storage cleanup, project
+   scripts, and archived threads. */
+html[data-t3-lobby] [data-settings-section="/settings/providers"],
+html[data-t3-lobby] [data-settings-section="/settings/keybindings"],
+html[data-t3-lobby] [data-settings-section="/settings/integrations"],
+html[data-t3-lobby] [data-settings-section="/settings/scheduled-tasks"],
+html[data-t3-lobby] [data-settings-section="/settings/source-control"],
+html[data-t3-lobby] [data-settings-section="/settings/storage"],
+html[data-t3-lobby] [data-settings-section="/settings/projects"],
+html[data-t3-lobby] [data-settings-section="/settings/archived"] {
+  display: none !important;
+}
+
+/* Embedded (?embed in the lobby's frame): the lobby's session bar is the header. */
+html[data-t3-embed] [data-slot="sidebar"],
+html[data-t3-embed] [data-chat-header] {
+  display: none !important;
+}
